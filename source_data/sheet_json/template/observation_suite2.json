{
  "flow_type": "template",
  "flow_name": "observation_suite2",
  "status": "released",
  "rows": [
    {
      "name": "choix_annee",
      "value": "@calc(String(@local.selected_year || '').trim() === '')"
    },
    {
      "name": "aff_data",
      "value": "@calc(String(@local.selected_year || '').trim() !== '')"
    },
    {
      "name": "selected_year",
      "value": "@calc(String(@fields.selected_observation_year|| '').slice(0, 4))"
    },
    {
      "name": "selected_semis_id",
      "value": "@calc(((Object.values(@data.semis || {}).find(item => String(item.upa_code || '') === String(@fields.upa_code) && String(item.year || '') === String(@local.selected_year)) || {}).id || ''))"
    },
    {
      "name": "selected_post_semis_id",
      "value": "@calc(((Object.values(@data.post_semis || {}).find(item => String(item.upa_code || '') === String(@fields.upa_code) && String(item.year || '') === String(@local.selected_year)) || {}).id || ''))"
    },
    {
      "name": "selected_recolte_id",
      "value": "@calc(((Object.values(@data.recolte || {}).find(item => String(item.upa_code || '') === String(@fields.upa_code) && String(item.year || '') === String(@local.selected_year)) || {}).id || ''))"
    },
    {
      "name": "has_obs_recolte",
      "value": "@calc(Object.values(@data.recolte_culture || {}).some(item => String(item.upa_code || '') === String(@fields.upa_code) && String(item.recolte_id || '').replace('id_', '').trim() === String(@local.selected_recolte_id || '').replace('id_', '').trim() && (!!item.observation_audio || !!item.observation_image || !!item.observation_videos || !!item.observation_texte)))"
    },
    {
      "type": "begin_template",
      "value": "evaluation_page_entete"
    },
    {
      "name": "page_id",
      "value": "observations"
    },
    {
      "type": "end_template"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.choix_annee_text"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 20px;"
    },
    {
      "type": "date_time_picker",
      "name": "selected_observation_year",
      "value": "@fields.selected_observation_year",
      "action_list": "changed | set_field: selected_observation_year: this.value;",
      "parameter_list": "type: year; min: 2023; max: @calc(now());\n\n",
      "style_list": "flex: 1; max-width: 300px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.text_obs_suite2 ",
      "condition": "@local.aff_data",
      "style_list": "color:#1e3656; margin:18px 12px 10px; font-size:18px; font-weight:800;"
    },
    {
      "type": "begin_display_group",
      "name": "suit1",
      "style_list": "display: flex; flex-direction: column; width: 100%; padding: 0 16px;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.recolte_culture",
      "parameter_list": "filter: @item.id && String(@item.upa_code || '') === String(@fields.upa_code) && String(@item.recolte_id || '').replace('id_', '').trim() === String(@local.selected_recolte_id || '').replace('id_', '').trim() && (!!@item.observation_audio || !!@item.observation_image || !!@item.observation_videos || !!@item.observation_texte)",
      "style_list": "display: flex; flex-direction: column; gap: 16px; width: 100%;"
    },
    {
      "type": "begin_display_group",
      "name": "suit2",
      "style_list": "display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fbfbf9; padding: 20px 16px; width: 100%;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@item.culture_id || '').toLowerCase().trim()) ? 'images/' + @item.culture_id + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60px; height: 60px; object-fit: contain; margin-bottom: 10px;"
    },
    {
      "type": "text",
      "value": "@item.culture_id",
      "style_list": "font-weight: bold; font-size: 15px; color: #1e3656; text-transform: capitalize;"
    },
    {
      "type": "begin_display_group",
      "name": "suit3",
      "style_list": "display: flex; justify-content: center; gap: 8px; margin-top: 8px;"
    },
    {
      "type": "audio",
      "name": "audio_observation_@item.id",
      "parameter_list": "variant: button_only;\nsrc: @item.observation_audio;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "condition": "!!@item.observation_audio",
      "style_list": "max-width: 36px; max-height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; overflow: hidden;"
    },
    {
      "type": "begin_display_group",
      "action_list": "click | set_field: selected_observation_text: @item.observation_texte;click | set_field: selected_observation_culture: @item.culture_id;click | go_to: observation_texte;",
      "condition": "!!@item.observation_texte"
    },
    {
      "type": "image",
      "value": "images/document.png",
      "style_list": "width: 28px; height: 28px; object-fit: contain;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "action_list": "click | set_field: selected_observation_image: @item.observation_image;click | set_field: selected_observation_culture: @item.culture_id;click | go_to: observation_photo;",
      "condition": "!!@item.observation_image"
    },
    {
      "type": "image",
      "value": "images/camera.png",
      "style_list": "width: 28px; height: 28px; object-fit: contain;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "action_list": "click | set_field: selected_observation_video: @item.observation_videos;click | set_field: selected_observation_culture: @item.culture_id;click | go_to: observation_video;",
      "condition": "!!@item.observation_videos"
    },
    {
      "type": "image",
      "value": "images/video.png",
      "style_list": "width: 28px; height: 28px; object-fit: contain;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "condition": "!@local.has_obs_recolte && @local.aff_data",
      "style_list": "padding: 22px 16px; margin: 10px 12px; background: #fff7ed;text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.no_data_text",
      "style_list": "color: #9a3412; font-weight: 700; font-size: 15px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.choix_annee ",
      "style_list": "padding: 22px 16px; margin: 10px 12px; background: #ffffff;text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.choice_year",
      "style_list": "color: red; font-weight: 700; font-size: 15px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "sticky: bottom; background: #ffffff; padding: 8px 12px 0 12px; width: 100%; box-sizing: border-box;"
    },
    {
      "type": "round_button",
      "name": "retour",
      "action_list": "click | go_to: observation_suite1",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;\n",
      "style_list": "width: 36px; height: 36px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "navigation_bar",
      "parameter_list": "button_list: @data.footer;\n",
      "style_list": "position: fixed; bottom: 0; left: 0; box-sizing: border-box; "
    }
  ]
}
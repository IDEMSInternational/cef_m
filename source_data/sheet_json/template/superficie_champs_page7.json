{
  "flow_type": "template",
  "flow_name": "superficie_champs_page7",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "VARIETE UTILISEE DANS LA PARCELLE N° @fields.num_parcelle de *@fields.nom_champ*"
    },
    {
      "name": "attempt_submit_p8",
      "value": "@fields.attempt_submit_p8"
    },
    {
      "name": "is_autre_variete",
      "value": "@calc(!!@fields.variete_semence && (String(@fields.variete_semence).indexOf('autre_variete_') === 0 || @fields.variete_semence === 'autre_cult1_variete'))"
    },
    {
      "name": "nom_variete",
      "value": "@calc(@local.is_autre_variete ? @fields.nom_autre_variete : @fields.variete_semence)"
    },
    {
      "name": "valid_source_autre",
      "value": "@calc(@fields.source_semence_culture !== 'semence_autre_source' || (!!@fields.autre_source_semence_culture && @fields.autre_source_semence_culture !== ''))"
    },
    {
      "name": "valid_p8",
      "value": "@calc(!!@fields.variete_semence && (!@local.is_autre_variete || (!!@fields.nom_autre_variete && @fields.nom_autre_variete !== '')) && !!@fields.type_variete_culture && !!@fields.source_semence_culture && @local.valid_source_autre)"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%;"
    },
    {
      "type": "text",
      "value": "@global.title_page7",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_8_1",
      "parameter_list": "variant: button_only; src: audio/Superficie/variete_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "radio_button_grid",
      "name": "variete_semence",
      "value": "@fields.variete_semence",
      "action_list": "changed | set_field: variete_semence: this.value;",
      "parameter_list": "answer_list: @data.type_variete; \nvariant: flex; item_width: 110px; grid_gap: 10px; style: secondary;"
    },
    {
      "type": "text",
      "value": "@global.warning_message",
      "condition": "@fields.attempt_submit_p8 && !@fields.variete_semence",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.is_autre_variete",
      "style_list": "display: block; width: 100%;"
    },
    {
      "type": "text",
      "value": "@global.n_variete",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_8_1",
      "parameter_list": "variant: button_only; src: audio/Superficie/var_seme_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "text_box",
      "name": "nom_autre_variete",
      "value": "@fields.nom_autre_variete",
      "action_list": "changed | set_field: nom_autre_variete: this.value;",
      "parameter_list": "max_length: 50; placeholder: Entrez le nom...;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.error_n_variete",
      "condition": "@fields.attempt_submit_p8 && @local.is_autre_variete && !@fields.nom_autre_variete",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%; margin-top: 15px;"
    },
    {
      "type": "text",
      "value": "@global.type_n_variete",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_8_2",
      "parameter_list": "variant: button_only; src: audio/Superficie/var_type_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "radio_button_grid",
      "name": "type_variete_culture",
      "value": "@fields.type_variete_culture",
      "action_list": "changed | set_field: type_variete_culture: this.value;",
      "parameter_list": "answer_list: @data.type_variete; variant: flex; item_width: 120px; grid_gap: 10px;"
    },
    {
      "type": "text",
      "value": "@global.select_warring",
      "condition": "@fields.attempt_submit_p8 && !@fields.type_variete_culture",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style:column",
      "condition": "@fields.type_variete_culture",
      "style_list": "display: block; width: 100%; margin-top: 15px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.select_source",
      "style_list": "color: #1e3656; font-weight: bold"
    },
    {
      "type": "audio",
      "name": "audio_8_2",
      "parameter_list": "variant: button_only; src: audio/Superficie/source_semence_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "radio_button_grid",
      "name": "source_semence_culture",
      "value": "@fields.source_semence_culture",
      "action_list": "changed | set_field: source_semence_culture: this.value;",
      "parameter_list": "answer_list: @data.source_semence; variant: list;"
    },
    {
      "type": "text",
      "value": "@global.select_warring",
      "condition": "@fields.attempt_submit_p8 && !@fields.source_semence_culture",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.source_semence_culture == 'semence_autre_source'",
      "style_list": "display: block; width: 100%;"
    },
    {
      "type": "text",
      "value": "@global.other_source"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only; src: audio/Superficie/nom_autre_source_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "autre_source_semence_culture",
      "value": "@fields.autre_source_semence_culture",
      "action_list": "changed | set_field: autre_source_semence_culture: this.value;",
      "parameter_list": "max_length: 50; placeholder: Nom de la source...;",
      "condition": "@fields.source_semence_culture == 'semence_autre_source'"
    },
    {
      "type": "text",
      "value": "@global.warning_message ",
      "condition": "@fields.attempt_submit_p8 && @fields.source_semence_culture == 'semence_autre_source' && !@fields.autre_source_semence_culture",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page8_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page8_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('variete_semence_P' + @fields.num_parcelle) : @fields.variete_semence;\n        click | set_field: @calc('nom_variete_P' + @fields.num_parcelle) : @local.nom_variete;\n        click | set_field: @calc('type_variete_P' + @fields.num_parcelle) : @fields.type_variete_culture;\n        click | set_field: @calc('source_semence_P' + @fields.num_parcelle) : @fields.source_semence_culture;\n        click | set_field: @calc('autre_source_semence_P' + @fields.num_parcelle) : @fields.autre_source_semence_culture;\n        click | emit: completed;",
      "parameter_list": "disabled: !@local.valid_p8",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
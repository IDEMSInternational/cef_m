{
  "flow_type": "template",
  "flow_name": "enrolment_page10",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.foncier_agricole"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%\n"
    },
    {
      "type": "subtitle",
      "value": "@global.sup_possede"
    },
    {
      "type": "audio",
      "name": "audio_10_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/sup_poss_upa_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float:right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sup_tot.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "text_box",
      "name": "superficie_possede_upa",
      "value": "@fields.superficie_possede_upa",
      "action_list": "changed | set_field: superficie_possede_upa: this.value;",
      "parameter_list": "number_input: true; placeholder: Nombre hectares possédés;"
    },
    {
      "name": "v_poss",
      "value": "@calc((/^\\d+(\\.\\d+)?$/.test(@local.superficie_possede_upa) && Number(@local.superficie_possede_upa) > 0) || !@local.superficie_possede_upa)\n"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.superficie_possede_upa && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.valeur_positive",
      "condition": "!@local.v_poss",
      "style_list": "color: red; font-size: 12px;"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "subtitle",
      "value": "@global.sup_cult"
    },
    {
      "type": "audio",
      "name": "audio_10_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/sup_cult_upa_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float:right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sup_cult.jpg\n",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "text_box",
      "name": "superficie_cultive_upa",
      "value": "@fields.superficie_cultive_upa",
      "action_list": "changed | set_field: superficie_possede_upa: this.value;",
      "parameter_list": "number_input: true; placeholder: Nombre hectares cultivés;"
    },
    {
      "name": "v_cult",
      "value": "@calc((/^\\d+(\\.\\d+)?$/.test(@local.superficie_cultive_upa) && Number(@local.superficie_cultive_upa) > 0) || !@local.superficie_cultive_upa)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.superficie_cultive_upa && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.valeur_positive",
      "condition": "!@local.v_cult",
      "style_list": "color: red; font-size: 12px;"
    },
    {
      "type": "text",
      "value": "@global.erreur_surface",
      "condition": "@local.v_poss && @local.v_cult && Number(@local.superficie_cultive_upa) > Number(@local.superficie_possede_upa)",
      "style_list": "color: red; font-weight: bold;"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(@local.v_poss && @local.v_cult && Number(@local.superficie_possede_upa) > 0 && Number(@local.superficie_cultive_upa) <= Number(@local.superficie_possede_upa))"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;variant: no-background;"
    },
    {
      "type": "button",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: superficie_possede_upa: @local.superficie_possede_upa;\nclick | set_field: superficie_cultive_upa: @local.superficie_cultive_upa;\nclick | set_field: attempt_submit: false;\nclick | emit: completed\n",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "caracteristique_upa",
  "status": "released",
  "rows": [
    {
      "type": "begin_template",
      "value": "evaluation_page_entete"
    },
    {
      "name": "page_id",
      "value": "caracteristique_upa"
    },
    {
      "type": "end_template"
    },
    {
      "type": "text",
      "value": "@global.choix_annee_text"
    },
    {
      "type": "date_time_picker",
      "value": "@fields.date_choisie",
      "action_list": "changed | set_field: date_choisie: this.value;\n\n",
      "parameter_list": "type: year;\nmin: 2023; max: @calc(now());"
    },
    {
      "name": "annee_choisie",
      "value": "@calc(String(@fields.date_choisie || '').substring(0,4))",
      "condition": "@calc(!!@fields.date_choisie)"
    },
    {
      "name": "last_upa_entry",
      "value": "@calc(Object.values(@data.upa_detail).filter(item => item.upa_code == @fields.upa_code && item.year == @local.annee_choisie).slice(-1)[0])",
      "condition": "@local.annee_choisie"
    },
    {
      "type": "begin_task_card",
      "condition": "!!@local.annee_choisie && @calc(@local.last_upa_entry && Object.keys(@local.last_upa_entry || {}).length > 0)",
      "style_list": "padding-bottom: 100px;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style:column",
      "condition": "!!@local.annee_choisie && @calc(@local.last_upa_entry && Object.keys(@local.last_upa_entry || {}).length > 0)"
    },
    {
      "type": "begin_data_items",
      "value": "@data.liste_caract_upa"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; width: 100%; box-sizing: border-box; justify-content: space-between; align-items: center; padding: 10px 4px; gap: 12px;"
    },
    {
      "type": "text",
      "value": "@item.caract_title",
      "style_list": "box-sizing: border-box; text-align: left; font-size: 16px;"
    },
    {
      "type": "text",
      "value": "String(@local.last_upa_entry[@item.caract_label])",
      "style_list": "box-sizing: border-box; text-align: right; font-size: 14px; font-weight: bold;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_task_card"
    },
    {
      "type": "begin_display_group",
      "condition": "!@local.last_upa_entry && @local.annee_choisie",
      "style_list": "padding: 22px 16px; margin: 10px 12px; background: #fff7ed;text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.no_data_text",
      "style_list": "color: #9a3412; font-weight: 700; font-size: 15px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "navigation_bar",
      "parameter_list": "button_list: @data.footer;",
      "style_list": "position: fixed; bottom: 0; left: 0; box-sizing: border-box; "
    }
  ]
}
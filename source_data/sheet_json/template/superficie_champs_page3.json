{
  "flow_type": "template",
  "flow_name": "superficie_champs_page3",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "**Niveau de fertilité de la parcelle N⁰ @fields.num_parcelle de @fields.nom_champ**"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.note_fertilite"
    },
    {
      "type": "audio",
      "name": "audio_5_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/fertilite_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/fertilite.jpg",
      "style_list": "width: 80%; object-fit: contain;\n"
    },
    {
      "type": "text",
      "name": "html_text",
      "value": "@global.select_nd",
      "style_list": "color: black;"
    },
    {
      "type": "radio_button_grid",
      "name": "fertilite_sol",
      "value": "@fields.fertilite_sol",
      "action_list": "changed | set_field : fertilite_sol: this.value;",
      "parameter_list": "answer_list: @data.fertilite_sol; \nstyle: secondary;\nitem_width: 60px;\ngrid_gap: 8px;"
    },
    {
      "type": "text",
      "name": "html_text",
      "value": "@global.warning_message",
      "condition": "!@local.fertilite_sol",
      "style_list": "color: red;"
    },
    {
      "name": "completed_enabled",
      "value": "@local.fertilite_sol ",
      "style_list": true
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page5_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page5_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('fertilite_sol_parcelle_N' + @fields.num_parcelle) : @fields.fertilite_sol;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
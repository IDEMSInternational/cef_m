      "type": "set_field",
      "name": "total_frais_deplacement",
      "value": "@calc(Math.round(@fields.nombre_enfants * @fields.frais_deplacement * 160.0))"
    },
    {
      "type": "text",
      "value": "@global.frais_annuel_deplacement_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "style_list": "background: #FFF3E0; border-radius: 15px; text-align: center; border: 2px solid #E65100;"
    },
    {
      "type": "text",
      "value": "@global.transport_scolaire",
      "style_list": "font-size: 16px; color: #6D4C41;"
    },
    {
      "type": "text",
      "value": "@fields.total_frais_deplacement drm",
      "style_list": "background: #E8F5E9; border-radius: 10px; color: #2E7D32; font-weight: bold; font-size: 20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.frais_recreation"
    },
    {
      "type": "audio",
      "name": "audio_7_4",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/recreation_annuel_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "set_field",
      "name": "total_frais_recreation",

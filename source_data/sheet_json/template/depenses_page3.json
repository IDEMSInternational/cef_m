{
  "flow_type": "template",
  "flow_name": "depenses_page3",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.petite_depenses"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "text",
      "name": "depense_sante",
      "value": "@global.depense_sante"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "name": "note_frais_sante_approche",
      "value": "@global.note_frais_sante_approche"
    },
    {
      "type": "audio",
      "name": "audio_3_1",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/approche_sante_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sante.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "note_frais_sante_approche_hint",
      "value": "@global.note_frais_sante_approche_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "name": "nombre_personne_upa_label",
      "value": "@global.nombre_personne_upa_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "audio",
      "name": "audio_3_2",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/nbre_residents_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/membres.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text",
      "name": "nombre_personne_upa_hint",
      "value": "@global.nombre_personne_upa_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "nombre_personne_upa",
      "value": "@fields.nombre_personne_upa",
      "action_list": "changed | set_field : nombre_personne_upa: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_nombre_personne_upa",
      "value": "@calc(!!@fields.nombre_personne_upa && @fields.nombre_personne_upa != \"\" && @fields.nombre_personne_upa >= 0)"
    },
    {
      "type": "text",
      "name": "error_nombre_personne_upa",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.nombre_personne_upa",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "frais_sante_annuel",
      "value": "@calc(Number(@fields.nombre_personne_upa * 3000))"
    },
    {
      "name": "note_frais_sante_cfa",
      "value": "@calc(Number(@local.frais_sante_annuel || 0) * 5)"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.montant_prev_sante"
    },
    {
      "type": "audio",
      "name": "audio_3_3",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/sante_annuel_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@local.valid_nombre_personne_upa",
      "style_list": "background: #FFF3E0; border-radius: 15px; text-align: center; border: 2px solid #E65100;"
    },
    {
      "type": "text",
      "value": "@global.note_frais_sante",
      "style_list": "font-size: 16px; color: #6D4C41;"
    },
    {
      "type": "text",
      "value": "@local.frais_sante_annuel drm",
      "style_list": "color: #E65100; margin: 10px 0;"
    },
    {
      "type": "text",
      "value": "@local.note_frais_sante_cfa FCFA",
      "style_list": "color: #2E7D32; font-weight: bold; font-size: 20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "note_frais_sante_hint",
      "value": "@global.note_frais_sante_hint",
      "style_list": "@global.hint_style"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_nombre_personne_upa"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_3_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_3_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_3_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: false;\nclick | set_field: frais_sante_annuel: @local.frais_sante_annuel;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
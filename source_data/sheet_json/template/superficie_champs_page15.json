{
  "flow_type": "template",
  "flow_name": "superficie_champs_page15",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "Mesurez à l'aide du GPS la superficie de @fields.cult_princip dans la parcelle N⁰@fields.num_parcelle"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.note_superf_geo"
    },
    {
      "type": "audio",
      "name": "audio_20",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/sup_mes_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/superf_geoloca.jpg",
      "style_list": "width: 40%; object-fit: contain;\n\n\n"
    },
    {
      "type": "text",
      "value": "@global.hint_superf_geo",
      "style_list": "color: red;"
    },
    {
      "type": "text_box",
      "name": "superficie_geo",
      "value": "@fields.superficie_parcelle"
    },
    {
      "type": "begin_data_items",
      "value": "@data.Parcelles",
      "condition": false
    },
    {
      "type": "text",
      "value": "parcelle: @item.numero_parcelle"
    },
    {
      "type": "text",
      "value": "@item.trace_superficie"
    },
    {
      "type": "end_data_items"
    },
    {
      "name": "Mali_lon",
      "value": "-5.54"
    },
    {
      "name": "Mali_lat",
      "value": "12.55"
    },
    {
      "name": "zoom",
      "value": 15
    },
    {
      "type": "map",
      "name": "test_map",
      "parameter_list": "<span>data_list: test_map_data;<br/>geometry_field_name:trace_superficie; <br/>center_lon: @local.Mali_lon;<br/>center_lat: @local.Mali_lat;<br/>zoom: @local.zoom;<br/></span><span><b>editable: false;</b></span>"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.superficie_parcelle ",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page15_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page15_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: superficie_geo: @fields.superficie_parcelle;\nclick | set_field: @calc('superficie_geo_parcelle_N' + @fields.num_parcelle) : @fields.superficie_geo;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
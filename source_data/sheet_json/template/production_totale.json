{
  "flow_type": "template",
  "flow_name": "production_totale",
  "status": "released",
  "parameter_list": {
    "app_config": {
      "APP_FOOTER_DEFAULTS": {
        "template": "footer"
      }
    }
  },
  "rows": [
    {
      "name": "selected_year",
      "value": "@calc(String(@fields.selected_production_year || '').slice(0, 4))"
    },
    {
      "name": "has_recoltes",
      "value": "@calc(Object.values(@data.productions_cultures || {}).some(item => String(item.upa_code || '') === String(@fields.upa_code) && String(item.year || '') === String(@local.selected_year)))"
    },
    {
      "name": "choix_annee",
      "value": "@calc(String(@local.selected_year || '').trim() === '')"
    },
    {
      "name": "aff_data",
      "value": "@calc(String(@local.selected_year || '').trim() !== '')"
    },
    {
      "type": "begin_template",
      "value": "evaluation_page_entete"
    },
    {
      "name": "page_id",
      "value": "production_totales"
    },
    {
      "type": "end_template"
    },
    {
      "type": "text",
      "value": "@global.choix_annee_text"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 20px;"
    },
    {
      "type": "date_time_picker",
      "name": "selected_production_year",
      "value": "@fields.selected_production_year",
      "action_list": "changed | set_field: selected_production_year: this.value;",
      "parameter_list": "type: year; min: 2023; max: @calc(now());\n",
      "style_list": "flex: 1; max-width: 300px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.aff_data",
      "style_list": "width: 100%; padding: 0 12px;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.productions_cultures",
      "parameter_list": "filter: String(@item.upa_code || '') === String(@fields.upa_code) && String(@item.year || '') === String(@local.selected_year)",
      "style_list": "display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; padding: 0 12px; width: 100%;"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fbfbf9; padding: 12px;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap','soja'].includes((@item.culture_id || '').toLowerCase().trim()) ? 'images/' + @item.culture_id + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 54px; height: 54px; object-fit: contain; margin-bottom: 8px;"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; flex-direction: column; align-items: center; text-align: center;"
    },
    {
      "type": "text",
      "value": "@item.culture_id",
      "style_list": "font-weight: bold; font-size: 15px; color: #1e3656; text-transform: capitalize;"
    },
    {
      "type": "text",
      "value": "@calc(Number(@item.production_kg || 0).toLocaleString() + ' kg')",
      "style_list": "font-weight: bold; font-size: 16px; color: #000000; "
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "!@local.has_recoltes && @local.aff_data",
      "style_list": "padding: 22px 16px; margin: 10px 12px; background: #fff7ed;text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.no_data_text ",
      "style_list": "color: #9a3412; font-weight: 700; font-size: 15px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.choix_annee ",
      "style_list": "padding: 22px 16px; margin: 10px 12px; background: #ffffff;text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.choice_year",
      "style_list": "color: red; font-weight: 700; font-size: 15px;"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "depenses_page10",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.investissement"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "subtitle",
      "name": "invest_maison_label",
      "value": "@global.invest_maison_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "image",
      "value": "images/maison.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "invest_maison",
      "value": "@fields.invest_maison",
      "action_list": "changed | set_field : invest_maison: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_invest_maison",
      "value": "@calc(!!@fields.invest_maison && @fields.invest_maison != \"\" && @fields.invest_maison >= 0)"
    },
    {
      "type": "text",
      "name": "error_invest_maison",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_invest_maison",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px; margin-top:10px;"
    },
    {
      "type": "subtitle",
      "name": "invest_mariage_label",
      "value": "@global.invest_mariage_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "image",
      "value": "images/mariage.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "invest_mariage",
      "value": "@fields.invest_mariage",
      "action_list": "changed | set_field : invest_mariage: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_invest_mariage",
      "value": "@calc(!!@fields.invest_mariage && @fields.invest_mariage != \"\" && @fields.invest_mariage >= 0)"
    },
    {
      "type": "text",
      "name": "error_invest_mariage",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_invest_mariage",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px; margin-top:10px;"
    },
    {
      "type": "subtitle",
      "name": "invest_equipment_label",
      "value": "@global.invest_equipment_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "image",
      "value": "images/equipement.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text",
      "value": "@global.invest_equipment_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "invest_equipment",
      "value": "@fields.invest_equipment",
      "action_list": "changed | set_field : invest_equipment: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_invest_equipment",
      "value": "@calc(!!@fields.invest_equipment && @fields.invest_equipment != \"\" && @fields.invest_equipment >= 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_invest_equipment",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px; margin-top:10px;"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_invest_maison && @local.valid_invest_mariage && @local.valid_invest_equipment"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_10_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_10_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_10_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
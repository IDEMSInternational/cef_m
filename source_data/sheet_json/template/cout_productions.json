{
  "flow_type": "template",
  "flow_name": "cout_productions",
  "status": "released",
  "parameter_list": {
    "app_config": {
      "APP_FOOTER_DEFAULTS": {
        "template": "footer"
      }
    }
  },
  "rows": [
    {
      "name": "selected_year",
      "value": "@calc(String(@fields.selected_cout_year|| '').substring(0,4))"
    },
    {
      "name": "choix_annee",
      "value": "@calc(String(@local.selected_year || '').trim() === '')"
    },
    {
      "name": "aff_data",
      "value": "@calc(String(@local.selected_year || '').trim() !== '')"
    },
    {
      "name": "musaka_mume",
      "value": "@calc(Object.values(@data.couts_cultures || {}).filter(item => String(item.upa_code || '').trim() === String(@fields.upa_code || '').trim() && String(item.year || '').trim() === String(@local.selected_year || '').trim()).reduce((sum, item) => sum + Number(item.cout_total || 0), 0))"
    },
    {
      "name": "has_couts",
      "value": "@calc(@local.musaka_mume > 0)"
    },
    {
      "type": "begin_template",
      "name": "entete",
      "value": "evaluation_page_entete"
    },
    {
      "name": "page_id",
      "value": "production_couts"
    },
    {
      "type": "end_template"
    },
    {
      "type": "begin_display_group",
      "name": "card1"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.choix_annee_text"
    },
    {
      "type": "begin_display_group",
      "name": "card2",
      "style_list": "display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 20px;"
    },
    {
      "type": "date_time_picker",
      "name": "selected_cout_year",
      "value": "@fields.selected_cout_year",
      "action_list": "changed | set_field: selected_cout_year: this.value;",
      "parameter_list": "type: year; min: 2023; max: @calc(now());\n\n",
      "style_list": "flex: 1; max-width: 300px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "card3",
      "condition": "@local.aff_data && @local.has_couts",
      "style_list": "display: flex; justify-content: space-around; align-items: center; padding: 22px 20px; margin-bottom: 22px; border-bottom: 1px solid #e5e7eb;"
    },
    {
      "type": "text",
      "value": "@global.montant_total",
      "style_list": "font-weight:800; color:#001b44; font-size:16px;"
    },
    {
      "type": "text",
      "value": "@local.musaka_mume drm",
      "style_list": "font-weight:900; color:#45c5b8; font-size:16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "card4",
      "condition": "@local.aff_data && @local.has_couts\n",
      "style_list": "display: flex; flex-direction: column; width: 100%; padding: 0 16px;"
    },
    {
      "type": "begin_data_items",
      "name": "item_@item.id",
      "value": "@data.couts_cultures",
      "parameter_list": "filter: String(@item.upa_code || '').trim() === String(@fields.upa_code || '').trim() && String(@item.year || '').trim() === String(@local.selected_year || '').trim() && Number(@item.cout_total) > 0",
      "style_list": "display: flex; flex-direction: column; gap: 16px; width: 100%;"
    },
    {
      "type": "begin_display_group",
      "name": "card",
      "style_list": "display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fbfbf9; padding: 20px 16px; width: 100%;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap','soja'].includes((@item.culture_id || '').toLowerCase().trim()) ? 'images/' + @item.culture_id + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60px; height: 60px; object-fit: contain; margin-bottom: 10px;"
    },
    {
      "type": "text",
      "value": "@item.culture_id",
      "style_list": "font-weight:900; font-size:16px; color:#001b44; text-transform:capitalize; line-height:1.5;"
    },
    {
      "type": "text",
      "value": "@calc(Number(@item.cout_total || 0).toLocaleString() + ' drm')"
    },
    {
      "type": "begin_display_group",
      "name": "card5",
      "action_list": "click | set_field: selected_cout_culture: @item.culture_id;\nclick | set_field: selected_cout_culture_label: @item.culture_id;\nclick | go_to: cout_productions_detail;"
    },
    {
      "type": "image",
      "value": "images/eye.png",
      "style_list": "width: 40px; height: 40px; object-fit: contain;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "dis_3",
      "condition": "!@local.has_couts && @local.aff_data",
      "style_list": "padding: 22px 16px; margin: 10px 12px; background: #fff7ed;text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.no_data_text",
      "style_list": "color: #9a3412; font-weight: 700; font-size: 15px"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "card6",
      "condition": "@local.choix_annee ",
      "style_list": "padding: 22px 16px; margin: 10px 12px; background: #ffffff;text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.choice_year",
      "style_list": "color: red; font-weight: 700; font-size: 15px;"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "post_semi_page7",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "BILAN GLOBAL POST-SEMIS"
    },
    {
      "name": "v_grand_total",
      "value": "@calc(Number(@field.grand_total_post_semi || 0))"
    },
    {
      "name": "v_grand_total_fcfa",
      "value": "@calc(Number(@local.v_grand_total || 0) * 5)"
    },
    {
      "type": "text",
      "value": "@global.header_title",
      "style_list": "color: #1B5E20; font-weight: bold; font-size: 20px; text-align: center; margin-bottom: 10px;"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/postSemi/cout_tot_postsemis_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "flex-shrink: 0;"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "style_list": "width: 40%; object-fit: contain; display: block; margin: 10px auto;"
    },
    {
      "type": "begin_display_group",
      "name": "card_investissement",
      "style_list": "background: #FFF3E0; padding: 20px; border-radius: 15px; text-align: center; margin-bottom: 20px;"
    },
    {
      "type": "text",
      "value": "@global.lbl_total_label",
      "style_list": "color: #6D4C41; font-size: 14px; font-weight: bold; text-transform: uppercase; margin-bottom: 5px;"
    },
    {
      "type": "text",
      "value": "@local.v_grand_total Dram",
      "style_list": "color: #E65100; font-size: 28px; font-weight: bold; margin-bottom: 15px;"
    },
    {
      "type": "begin_display_group",
      "name": "subcard_fcfa",
      "style_list": "background: #E8F5E9; padding: 10px; border-radius: 10px;"
    },
    {
      "type": "text",
      "value": "@local.v_grand_total_fcfa FCFA",
      "style_list": "color: #2E7D32; font-weight: bold; font-size: 20px; text-align: center;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "cultures_list",
      "style_list": "padding: 15px 0; border-top: 1px solid #eee; border-bottom: 1px solid #eee; margin-bottom: 15px;"
    },
    {
      "type": "text ",
      "value": "@global.lbl_cultures_title",
      "style_list": "color: #e3a730; font-weight: bold; font-size: 14px; margin-bottom: 8px;"
    },
    {
      "type": "text ",
      "value": "@field.selected_cultures_list ",
      "style_list": "color: #666; font-style: italic; margin-top: 5px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.lbl_avis_title",
      "style_list": "color: #455A64; font-weight: bold; font-size: 14px; margin-bottom: 4px;"
    },
    {
      "type": "text",
      "value": "@global.lbl_avis_desc",
      "style_list": "color: gray; font-size: 12px; margin-bottom: 10px;"
    },
    {
      "type": "begin_display_group",
      "name": "feedback_card",
      "style_list": "display: block; width: 100%; border-radius: 10px; padding: 10px;"
    },
    {
      "type": "image",
      "value": "images/vocal.jpg",
      "style_list": "width: 50px; float: left; margin-right: 10px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "final_note",
      "style_list": "display: flex; flex-direction: column; align-items: center; text-align: center; background: white; padding: 20px; border-radius: 12px; margin-bottom: 20px;"
    },
    {
      "type": "text",
      "value": "@global.lbl_fin_title",
      "style_list": "color: #D84315; font-weight: bold; font-size: 18px; margin-bottom: 10px"
    },
    {
      "type": "text",
      "value": "@global.lbl_fin_desc",
      "style_list": "color: #333; font-size: 14px; line-height: 1.4;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | go_to: suivi_anl;",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
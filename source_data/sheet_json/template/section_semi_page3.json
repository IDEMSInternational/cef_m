{
  "flow_type": "template",
  "flow_name": "section_semi_page3",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "SÉLECTION DES CULTURES"
    },
    {
      "type": "begin_display_group",
      "name": "cult_sec",
      "style_list": "display: flex; flex-direction: row; align-items: center; justify-content: flex-start; width: 100%; margin-top: 15px; gap: 10px;"
    },
    {
      "type": "text",
      "value": "@global.secondary_crops_label",
      "style_list": "font-weight: 600; font-size: 18px; color: #333333; flex: 1;"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only; \nsrc: audio/postSemi/cult_second_fr.mp3; \nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "flex-shrink: 0;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.secondary_crops_hint",
      "style_list": "font-style: italic; color: #666666; font-size: 13px; margin-bottom: 15px;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.cultures_secondaires",
      "style_list": "display: flex; flex-wrap: wrap; justify-content: space-between; width: 100%; gap: 10px;"
    },
    {
      "type": "begin_display_group",
      "name": "card_culture_sec",
      "action_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #ddd; border-radius: 10px; background: white; margin-bottom: 10px; overflow: hidden;",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #ddd; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@item.image",
      "action_list": "width:100px; height:100px; ",
      "style_list": "width: 60%; object-fit: contain;"
    },
    {
      "name": "v_key1",
      "value": "@calc('sec_' + @item.name)"
    },
    {
      "type": "simple_checkbox",
      "name": "checkbox",
      "value": "@field.@local.v_key1",
      "action_list": "changed | set_field: @local.v_key1: @local.checkbox;",
      "parameter_list": "label_text: @item.text; reverse: true;",
      "style_list": "margin-bottom: 10px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "name": "v_forbidden",
      "value": "@calc(['fonio','riz','sésame','wouandzou','patate','bissap','mais','mil','sorgho','coton','arachide','fourrage', (@field.autre_culture_primaire_1 || '').toLowerCase().trim(), (@field.autre_culture_primaire_2 || '').toLowerCase().trim()].filter(v=>!!v))"
    },
    {
      "type": "begin_display_group",
      "name": "autre_sec_1",
      "condition": "@field.sec_autre_1",
      "style_list": "display: block; width: 100%; background: #f7fafc; padding: 15px; margin-top: 15px;"
    },
    {
      "type": "text",
      "value": "@global.sc_name_1_label",
      "style_list": "font-size: 14px; font-weight: 600; color: #333333; flex: 1;"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only; \nsrc: audio/postSemi/cult_second_nom1_fr.mp3; \nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "flex-shrink: 0;"
    },
    {
      "type": "text",
      "value": "@global.sc_name_other_hint",
      "style_list": "font-size: 12px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/autre_cult_1.jpg",
      "style_list": "width: 40%; object-fit: contain; "
    },
    {
      "type": "text_box",
      "name": "secondary_crop_1",
      "value": "@field.secondary_crop_1",
      "action_list": "changed | set_field: secondary_crop_1 : this.value;",
      "parameter_list": "placeholder: Nom de la culture...;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.error_culture\n",
      "condition": "@calc(@field.sec_autre_1 && !!@field.secondary_crop_1 && @local.v_forbidden.includes(@field.secondary_crop_1.toLowerCase().trim()))\n",
      "style_list": "color: #d71920; font-size: 12px; font-weight: bold; margin-top: 4px;"
    },
    {
      "type": "begin_display_group",
      "name": "autre_sec_2",
      "condition": "@field.sec_autre_2 && !!@field.secondary_crop_1 && !@local.v_forbidden.includes(@field.secondary_crop_1.toLowerCase().trim())",
      "style_list": "display: block; width: 100%; background: #f7fafc; padding: 15px;margin-top: 15px;"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only; \nsrc: audio/postSemi/cult_second_nom2_fr.mp3; \nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.sc_name_2_label",
      "style_list": "font-size: 14px; font-weight: 600; color: #333333; flex: 1;"
    },
    {
      "type": "text",
      "value": "@global.second_crops_sc",
      "style_list": "font-size: 12px; color: #718096; font-style: italic;"
    },
    {
      "type": "image",
      "value": "images/autre_cult_2.jpg",
      "style_list": "width: 40%; object-fit: contain;"
    },
    {
      "type": "text_box",
      "name": "secondary_crop_2",
      "value": "@field.secondary_crop_2",
      "action_list": "changed | set_field: secondary_crop_2 : this.value;",
      "parameter_list": "placeholder: Nom de la culture...;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.error_culture",
      "condition": "@calc(@field.sec_autre_2 && !!@field.secondary_crop_2 && (@local.v_forbidden.includes(@field.secondary_crop_2.toLowerCase().trim()) || @field.secondary_crop_1.toLowerCase().trim() == @field.secondary_crop_2.toLowerCase().trim()))",
      "style_list": "color: #d71920; font-size: 12px; font-weight: bold; margin-top: 4px;"
    },
    {
      "name": "v_list_prim",
      "value": "@calc([@field.cul_mais?'mais':null,@field.cul_mil?'mil':null,@field.cul_sorgho?'sorgho':null,@field.cul_coton?'coton':null,@field.cul_arachide?'arachide':null,@field.cul_fourrage?'fourrage':null,@field.cul_autre_1?@field.autre_culture_primaire_1:null,@field.cul_autre_2?@field.autre_culture_primaire_2:null].filter(v=>v!==null))"
    },
    {
      "name": "v_list_sec",
      "value": "@calc([@field.sec_fonio?'fonio':null,@field.sec_rice?'riz':null,@field.sec_sesame?'sésame':null,@field.sec_wouandzou?'wouandzou':null,@field.sec_patate_douce?'patate':null,@field.sec_bissap?'bissap':null,@field.sec_autre_1?@field.secondary_crop_1:null,@field.sec_autre_2?@field.secondary_crop_2:null].filter(v=>v!==null))"
    },
    {
      "name": "v_final_list",
      "value": "@calc(@local.v_list_prim.concat(@local.v_list_sec).join(','))"
    },
    {
      "name": "v_total_count",
      "value": "@calc(@local.v_list_prim.length + @local.v_list_sec.length)"
    },
    {
      "name": "v_sec_valid",
      "value": "@calc((!@field.sec_autre_1 || (!!@field.secondary_crop_1 && !@local.v_forbidden.includes(@field.secondary_crop_1.toLowerCase().trim()))) && (!@field.sec_autre_2 || (!!@field.secondary_crop_2 && !@local.v_forbidden.includes(@field.secondary_crop_2.toLowerCase().trim()) && @field.secondary_crop_1.toLowerCase().trim() !== @field.secondary_crop_2.toLowerCase().trim())))"
    },
    {
      "name": "completed_enabled",
      "value": "@local.v_sec_valid"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "Continuer",
      "action_list": "click | set_field: selected_cultures_list : @local.v_final_list;\nclick | set_field: total_cultures_selected : @local.v_total_count;\nclick | set_field: current_culture_index : 0;\nclick | set_field: active_culture_name : @calc(@local.v_final_list.split(',')[0]);\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "superficie_champs_page9",
  "status": "released",
  "rows": [
    {
      "name": "valid_nbre_arbre",
      "value": "@calc(/^\\d+$/.test(@fields.nombre_arbre) && Number(@fields.nombre_arbre) >= 0)"
    },
    {
      "name": "valid_nom_arbre",
      "value": "@calc(Number(@fields.nombre_arbre) === 0 || (Number(@fields.nombre_arbre) > 0 && !!@fields.nom_arbre && @fields.nom_arbre.trim() !== ''))"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(!!@fields.nombre_arbre && @local.valid_nbre_arbre && @local.valid_nom_arbre)"
    },
    {
      "type": "title",
      "value": "**La diversité culturale dans la parcelle  N⁰@fields.num_parcelle de @fields.nom_champ**"
    },
    {
      "type": "begin_data_items",
      "value": "@data.cult_princip",
      "parameter_list": "filter: @item.name == @fields.cult_princip"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width: 80%; object-fit: contain;\n"
    },
    {
      "type": "html",
      "value": "<span style=\"font-size: 16px; font-weight: bold; color: #1e3656;\">Culture principale : @item.name</span>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> Nombre d'arbres présents dans la parcelle :</label>"
    },
    {
      "type": "audio",
      "name": "audio_10_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/nbre_arbre_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; align-items: center; grid_gap: 15px; margin-top: 10px;"
    },
    {
      "type": "image",
      "value": "images/arbre.jpg",
      "style_list": "width:90px; height:90px; "
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "nombre_arbre",
      "value": "@fields.nombre_arbre",
      "action_list": "changed | set_field: nombre_arbre : this.value;",
      "parameter_list": "number_input: true\nplaceholder: Entrez le nombre;",
      "exclude_from_translation": true
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<span style=\"color: red; font-size: 13px;\">La réponse est obligatoire !</span>",
      "condition": "@fields.attempt_submit_p10 && !@fields.nombre_arbre"
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<span style=\"color: red; font-size: 13px;\">Veuillez entrer un nombre entier positif ou 0 !</span>",
      "condition": "!!@fields.nombre_arbre && !@local.valid_nbre_arbre"
    },
    {
      "name": "valid_nombre_arbre",
      "value": "@calc((/^\\d+$/.test(@local.nombre_arbre) && @local.nombre_arbre>= 0 ) || @local.nombre_arbre == '' || !@local.nombre_arbre)",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_nombre_arbre",
      "exclude_from_translation": true,
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.nombre_arbre > 0",
      "style_list": "display: block; width: 100%; margin-top: 15px; padding: 12px;"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> Écrivez le(s) nom(s) de(s) l'arbre(s) :</label>"
    },
    {
      "type": "audio",
      "name": "audio_10_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/nom_arbre_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "nom_arbre",
      "value": "@fields.nom_arbre",
      "action_list": "changed | set_field: nom_arbre : this.value;",
      "parameter_list": "placeholder: Entrez le nom de l'arbre;",
      "condition": "@fields.nombre_arbre > 0"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 13px;\">Veuillez préciser le nom de l'arbre !</span>",
      "condition": "@fields.attempt_submit_p10 && @fields.nombre_arbre > 0 && !@fields.nom_arbre",
      "exclude_from_translation": true
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page10_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page10_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('nombre_arbre_parcelle_N' + @fields.num_parcelle) : @fields.nombre_arbre;\n        click | set_field: @calc('nom_arbre_parcelle_N' + @fields.num_parcelle) : @fields.nom_arbre;\n        click | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
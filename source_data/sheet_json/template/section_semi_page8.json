{
  "flow_type": "template",
  "flow_name": "section_semi_page8",
  "status": "released",
  "rows": [
    {
      "name": "v_current_human",
      "value": "@calc(Number(@field.current_culture_index) + 1)"
    },
    {
      "name": "v_lab_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.superficie_labouree))"
    },
    {
      "name": "v_lab_err",
      "value": "@calc(!@local.v_lab_fmt || Number(@field.superficie_labouree) < 0)"
    },
    {
      "name": "v_cout_lab_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.cout_superficie_labouree_nonzero))"
    },
    {
      "name": "v_cout_lab_err",
      "value": "@calc(!@local.v_cout_lab_fmt || Number(@field.cout_superficie_labouree_nonzero) < 0)"
    },
    {
      "type": "begin_display_group",
      "name": "header",
      "style_list": "background: #00adcc; padding: 15px; border-radius: 0 0 15px 15px; margin-bottom: 20px;"
    },
    {
      "type": "text",
      "value": "CULTURE @local.v_current_human / @field.total_cultures_selected",
      "style_list": "color: white; font-weight: bold; font-size: 14px; text-transform: uppercase;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@field.active_culture_name || '').toLowerCase().trim()) ? 'images/' + @field.active_culture_name + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60%; object-fit: contain;"
    },
    {
      "type": "text",
      "value": "Culture : @field.active_culture_name",
      "style_list": "font-weight: bold; font-size: 18px; color: #e3a730; margin-top: 10px; text-align: center;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.lbl_section_title_8",
      "style_list": "color: #e67e22; font-weight: bold; font-size: 14px; margin-bottom: 10px; display: block;"
    },
    {
      "type": "begin_display_group",
      "name": "grp_quantite_pnt",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_pnt_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/sup_labour_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.lbl_labour_label",
      "style_list": "font-weight: bold; font-size: 14px; color: #333333; flex: 1;"
    },
    {
      "type": "text",
      "value": "@global.error_sup",
      "style_list": "font-size: 12px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/superf_unit.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "superficie_labouree",
      "value": "@field.superficie_labouree",
      "action_list": "changed | set_field: superficie_labouree: this.value;",
      "parameter_list": "number_input: true;"
    },
    {
      "type": "text",
      "value": "@global.error_positive_value",
      "condition": "@local.v_lab_err",
      "style_list": "font-size: 12px; color: red;"
    },
    {
      "type": "begin_display_group",
      "name": "cout_labour_zero",
      "condition": "@calc(Number(@field.superficie_labouree) == 0)",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_chaux_z_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/cout_labour_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.lbl_lab_z_label",
      "style_list": "font-weight: bold; font-size: 14px; color: #333333; flex: 1;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "value": 0,
      "parameter_list": "disabled:true;"
    },
    {
      "type": "text",
      "value": "@global.error_lab_val",
      "style_list": "font-size: 12px; color: #999;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "cout_labour_nonzero",
      "condition": "@calc(Number(@field.superficie_labouree) > 0)",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_lab_nz_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/cout_labour_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.lbl_lab_z_label",
      "style_list": "font-weight: bold; font-size: 14px; color: #333333; flex: 1;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "cout_superficie_labouree_nonzero",
      "value": "@field.cout_superficie_labouree_nonzero",
      "action_list": "changed | set_field: cout_superficie_labouree_nonzero: this.value;",
      "parameter_list": "number_input: true;\n\nplaceholder: Montant en Dram;"
    },
    {
      "type": "text",
      "value": "@global.error_positive_value",
      "condition": "@local.v_cout_lab_err",
      "style_list": "font-size: 12px; color: red;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_val_lab_nz",
      "value": "@calc(Number(@field.cout_superficie_labouree_nonzero) || 0)"
    },
    {
      "name": "v_final_lab",
      "value": "@calc(Number(@field.superficie_labouree) == 0 ? 0 : @local.v_val_lab_nz)"
    },
    {
      "name": "v_page6_valid",
      "value": "@calc(@local.v_lab_fmt && Number(@field.superficie_labouree) >= 0 && (Number(@field.superficie_labouree) == 0 || (@local.v_cout_lab_fmt && Number(@field.cout_superficie_labouree_nonzero) >= 0)))"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: cout_superficie_labouree : @local.v_final_lab;\n\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.v_page6_valid",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "enrolment_page1",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "consentement",
      "value": "@global.consentement_title"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "text",
      "name": "note_consentement",
      "value": "@global.consentement_note"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span> @global.consentement_question",
      "style_list": "font-size:20px;"
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.consentement_oui_non",
      "action_list": "changed | set_field : consentement_oui_non: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "value": "<p style=\"color: red;\"> @global.reponse_obligatoire </p>",
      "condition": "!@fields.consentement_oui_non && @fields.attempt_submit"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.consentement_oui_non"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page1_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_continue_no",
      "value": "Continuer",
      "action_list": "click | go_to: enrolment_page18;",
      "condition": "@fields.consentement_oui_non == 'non' ",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "button_continue_attempt_submit",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;\n",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_1_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: consentement_oui_non: @fields.consentement_oui_non;\nclick | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled && @fields.consentement_oui_non == 'oui' ",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
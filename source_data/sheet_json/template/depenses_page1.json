{
  "flow_type": "template",
  "flow_name": "depenses_page1",
  "status": "released",
  "rows": [
    {
      "type": "begin_display_group"
    },
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.depense_upa_title"
    },
    {
      "type": "audio",
      "name": "audio_3_1",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/planif_depense_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "note_depense",
      "value": "@global.note_depense"
    },
    {
      "type": "image",
      "value": "images/depenses_annuelles.jpg",
      "style_list": "width: 180px; height: 180px; object-fit: cover;"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_1_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_1_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
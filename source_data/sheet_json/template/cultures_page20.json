{
  "flow_type": "template",
  "flow_name": "cultures_page20",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.info_sup_upa"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.type_canal_info_label"
    },
    {
      "type": "audio",
      "name": "audio_18_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/canal_obser_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "error_type_canal_info",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.type_canal_info",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "radio_button_grid",
      "name": "type_canal_info",
      "value": "@fields.type_canal_info",
      "action_list": "changed | set_field : type_canal_info: this.value;",
      "parameter_list": "answer_list: @data.group_observation; \nvariant: flex;\nitem_width: 60px;\ngrid_gap: 8px;"
    },
    {
      "type": "text",
      "value": "@global.warning_message",
      "condition": "!@fields.type_canal_observ",
      "style_list": "color: red; font-size: 16px;"
    },
    {
      "type": "begin_display_group",
      "style_list": "background: #fdf6f0; color: #a44c20; border: 1px solid #f5decb; border-radius: 12px;18px; margin: 12px 0px; box-shadow: 0 4px 6px rgba(164, 76, 32, 0.02); font-size: 20px; font-weight: 500;"
    },
    {
      "type": "text",
      "value": "@global.culture_prevues",
      "style_list": "font-size: 18px; font-weight: bold;"
    },
    {
      "type": "text",
      "value": "@fields.culture_list_all\n",
      "style_list": "font-size: 18px; font-weight: bold; "
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.type_canal_info == \"par_text\""
    },
    {
      "type": "text",
      "value": "@global.info_text_label"
    },
    {
      "type": "audio",
      "name": "audio_18_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/oberv_ecrit_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_area",
      "name": "info_text",
      "value": "@fields.info_text",
      "action_list": "changed | set_field : info_text: this.value;",
      "parameter_list": "placeholder: @global.texte_placeholder;",
      "condition": "@fields.type_canal_info == \"par_text\""
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.type_canal_info == \"par_video\""
    },
    {
      "type": "text",
      "value": "@global.info_video_label"
    },
    {
      "type": "audio",
      "name": "audio_18_3",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/oberv_vid_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "button",
      "value": "@global.prendre_video",
      "parameter_list": "icon: images/icons/screen-recorder-svgrepo-com.svg",
      "condition": "@fields.type_canal_info == \"par_video\""
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.type_canal_info == \"par_vocal\""
    },
    {
      "type": "text",
      "value": "@global.info_audio_label"
    },
    {
      "type": "audio",
      "name": "audio_18_4",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/oberv_audio_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.info_audio_need",
      "condition": "@fields.type_canal_info == \"par_vocal\""
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.type_canal_info == \"par_photo\""
    },
    {
      "type": "text"
    },
    {
      "type": "audio",
      "name": "audio_18_5",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/oberv_phot_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "button",
      "value": "@global.prendre_photo",
      "parameter_list": "icon: images/icons/photo-svgrepo-com.svg",
      "condition": "@fields.type_canal_info == \"par_photo\""
    },
    {
      "name": "completed_enabled",
      "value": "!!@local.type_canal_info"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_18_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_18_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
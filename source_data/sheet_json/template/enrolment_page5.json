{
  "flow_type": "template",
  "flow_name": "enrolment_page5",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.activite_primaire"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.activite_primaire_label"
    },
    {
      "type": "audio",
      "name": "audio_5_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/act_prim_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group\n"
    },
    {
      "type": "radio_button_grid",
      "name": "grid_1",
      "value": "@field.activite",
      "action_list": "changed |set_field: activite: this.value; ",
      "parameter_list": "answer_list: @data.activite;\nvariant: flex;\nstyle: secondary;\nitem_width: 90px;\ngrid_gap: 8px;"
    },
    {
      "name": "v_pri",
      "value": "@calc(!!@field.activite)"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style:column",
      "condition": "@field.activite == 'autre1'"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.autre_activite_primaire "
    },
    {
      "type": "audio",
      "name": "audio_5_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/autre_act_prim_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "value": "@field.autre_activite_primaire",
      "action_list": "changed | set_field: autre_activite_primaire: this.value;",
      "parameter_list": "placeholder: Précisez le nom de l'autre...;",
      "style_list": "width: 100%; margin-top: 10px;"
    },
    {
      "name": "v_autre_pri",
      "value": "@calc(!!@field.autre_activite_primaire)"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@local.v_pri && (@field.activite != 'autre1' || @local.v_autre_pri)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@local.completed_enabled",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: activite_primaire: @calc(@field.autre_activite_primaire ?? @field.activite); \nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
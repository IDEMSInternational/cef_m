{
  "flow_type": "template",
  "flow_name": "enrolment_page2",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "title",
      "value": "@global.annee_campagne"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; flex-direction: row; align-items: center; justify-content: flex-start; width: 100%; margin-top: 20px; gap: 10px;"
    },
    {
      "type": "subtitle",
      "value": "@global.select_date",
      "style_list": "margin-top: 20px; font-weight: 600;"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/recolte/annee_saison_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "flex-shrink: 0;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "date_time_picker",
      "name": "season_label",
      "value": "@fields.season_label",
      "action_list": "changed | set_field: season_label: this.value;",
      "parameter_list": "type: year;\nmin: 2023; \nmax: @calc(now());"
    },
    {
      "name": "v_year_ok",
      "value": "@calc(!!@field.season_label)"
    },
    {
      "type": "text",
      "value": "@global.aucune_date",
      "condition": "!@local.v_year_ok",
      "style_list": "width: 100%; text-align: center; background: #f7fafc; border: 1px dashed #cbd5e0; border-radius: 12px; font-size: 18px; color: #718096;"
    },
    {
      "type": "text",
      "value": "@fields.season_label",
      "condition": "@local.v_year_ok",
      "style_list": "width:100%; text-align:center;background: #e6fffa; border: 2px solid #00adcc; border-radius: 12px; font-size:26px; font-weight:800; color:#00adcc; "
    },
    {
      "name": "year",
      "value": "@calc(@fields.season_label.substring(0,4))",
      "condition": "@fields.season_label"
    },
    {
      "name": "completed_enabled",
      "value": "@local.v_year_ok "
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 16px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;\n",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "value": "Continuer",
      "action_list": "click | set_field: year: @local.year;\n\nclick | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "besoins_animaux_page6",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.soins_veto_title"
    },
    {
      "type": "begin_data_items",
      "value": "@data.categorie_animaux",
      "parameter_list": "filter: @item.name == @fields.current_cat_animaux"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@item.text: @fields.nb_animaux tête(s)"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "note_soins_veto",
      "value": "@global.note_soins_veto"
    },
    {
      "type": "image",
      "value": "images/soins_veto.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.prix_unit_veto"
    },
    {
      "type": "text",
      "value": "@global.hint_prix_unit_veto",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text",
      "value": "@global.drm_cfa_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "frais_veterinaire_tete",
      "value": "@fields.frais_veterinaire_tete",
      "action_list": "changed | set_field: frais_veterinaire_tete : this.value;",
      "parameter_list": "number_input: true; placeholder: @global.texte_placeholder;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@local.frais_veterinaire_tete ",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "valid_frais_veterinaire_tete",
      "value": "@calc((/^\\d+$/.test(@local.frais_veterinaire_tete) && @local.frais_veterinaire_tete>0 ) || @local.frais_veterinaire_tete == '' || !@local.frais_veterinaire_tete )"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_frais_veterinaire_tete",
      "style_list": "@global.reponse_style",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.note_frais_totaux_veto",
      "condition": "@fields.frais_veterinaire_tete > 0"
    },
    {
      "type": "set_field",
      "name": "frais_veterinaire_cat",
      "value": "@calc(Number(@fields.frais_veterinaire_tete || 0) * Number(@fields.nb_animaux || 0))",
      "condition": "@fields.frais_veterinaire_tete > 0"
    },
    {
      "type": "text",
      "value": "@global.drm_cfa_hint",
      "condition": "@fields.frais_veterinaire_tete > 0"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "condition": "@fields.frais_veterinaire_tete > 0",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "value": "<div style=\"background-color: #f0f4f8; border-left: 4px solid #0056b3; padding: 12px 16px; border-radius: 4px; margin: 8px 0; font-family: sans-serif;\">\n Les frais totaux pour le(s) @fields.nb_animaux tête (s) de @item.text sont :  <strong> @fields.frais_veterinaire_cat drm\n</strong> </div>",
      "condition": "@fields.frais_veterinaire_tete > 0"
    },
    {
      "type": "begin_display_group",
      "style_list": "background-color: #f0f4f8; border-left-style: solid; border-left-color: #0056b3; border-radius: 5px;"
    },
    {
      "type": "text",
      "name": "note_totaux",
      "value": "@global.frais_totaux_veto",
      "condition": "@fields.frais_veterinaire_tete > 0"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "note_hint",
      "value": "@global.hint_frais_totaux_veto",
      "condition": "@fields.frais_veterinaire_tete > 0",
      "style_list": "font-size: 14px"
    },
    {
      "type": "end_data_items"
    },
    {
      "name": "last_cat_animaux",
      "value": "@calc((Number(@fields.cat_animaux_loop_idx) + 1) < Number(@fields.cat_animaux_selected_count))"
    },
    {
      "name": "cat_animaux_loop_idx",
      "value": "@calc(Number(@fields.cat_animaux_loop_idx) + 1)"
    },
    {
      "name": "current_cat_animaux",
      "value": "@calc([@fields.boeufs_labour ? 'boeufs_labour' : null, @fields.embouche_bovine ? 'embouche_bovine' : null, @fields.vache_laitiere ? 'vache_laitiere' : null, @fields.autres_bovins ? 'autres_bovins' : null, @fields.asins ? 'asins' : null, @fields.embouche_ovine ? 'embouche_ovine' : null, @fields.reste_ovins ? 'reste_ovins' : null, @fields.caprins ? 'caprins' : null].filter(v => v !== null).at(Number(@local.cat_animaux_loop_idx)) || '')"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.frais_veterinaire_tete"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page6_button_back",
      "action_list": "click | emit: uncompleted;",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_next_cat_animaux",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: frais_veterinaire_tete_@fields.current_cat_animaux: @fields.frais_veterinaire_tete;\nclick | set_field: frais_veterinaire_cat_@fields.current_cat_animaux: @fields.frais_veterinaire_cat;\n\nclick | set_field: type_regime:;\nclick | set_field: nb_animaux:;  \nclick | set_field: frais_veterinaire_tete:;  \nclick | set_field: frais_veterinaire_cat:; \n\nclick | set_field: current_cat_animaux : @local.current_cat_animaux;\n\nclick | set_field: cat_animaux_loop_idx : @local.cat_animaux_loop_idx;\nclick | set_data | _list_id: besoins_animaux_settings_pages, _index: 3, completed: false;\nclick | set_data | _list_id: besoins_animaux_settings_pages, _index: 4, completed: false;\nclick | set_data | _list_id: besoins_animaux_settings_pages, _index: 5, completed: false;\n",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.last_cat_animaux",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page6_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: frais_veterinaire_tete_@fields.current_cat_animaux: @fields.frais_veterinaire_tete;\nclick | set_field: frais_veterinaire_cat_@fields.current_cat_animaux: @fields.frais_veterinaire_cat;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "!@local.last_cat_animaux",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "besoins_humains_page2",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.prevision_title"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.perssonne_nourrir_label"
    },
    {
      "type": "audio",
      "name": "audio_2_1",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/nombre_nourris_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/membre_upa.jpg",
      "style_list": "width:180px; height:180px;"
    },
    {
      "type": "html",
      "value": "@global.perssonne_nourrir_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "personnes_nourrir",
      "value": "@fields.personnes_nourrir",
      "action_list": "changed | set_field: personnes_nourrir : this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;",
      "style_list": "margin-top: 10px;"
    },
    {
      "name": "besoin_cereale_exploitation",
      "value": "@calc(Number(@fields.personnes_nourrir || 0) * 3)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.personnes_nourrir && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.personnes_nourrir > 0"
    },
    {
      "type": "subtitle",
      "value": "@global.prevision_label"
    },
    {
      "type": "audio",
      "name": "audio_4_1",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/total_besoin_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.personnes_nourrir > 0",
      "style_list": "border-radius: 12px; color: white;"
    },
    {
      "type": "image",
      "value": "images/besoin_upa.jpg",
      "style_list": "width:190px; height:190px;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column"
    },
    {
      "type": "text",
      "value": "@global.prevision_label_hint1",
      "style_list": "text-transform: uppercase; font-size: 15px; font-weight: bold; margin-bottom: 2px;"
    },
    {
      "type": "text",
      "value": "@global.prevision_label_hint2",
      "style_list": "font-size: 22px; font-weight: bold; margin-bottom: 4px;"
    },
    {
      "type": "text",
      "value": "@global.prevision_label_hint3",
      "style_list": "font-size: 11px; color: gray; line-height: 1.2; margin: 0;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.personnes_nourrir"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page4_button_back",
      "action_list": "click | set_field: attempt_submit: false;\nclick | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_continue_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;\n",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_4button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: besoin_cereale_exploitation : @local.besoin_cereale_exploitation;\nclick | set_field: attempt_submit: false;\n\nclick | emit: completed",
      "parameter_list": "\ndisabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
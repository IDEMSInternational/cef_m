{
  "flow_type": "template",
  "flow_name": "section_semi_page2",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "SÉLECTION DES CULTURES"
    },
    {
      "type": "begin_display_group",
      "name": "cult_pri",
      "style_list": "display: flex; flex-direction: row; align-items: center; justify-content: flex-start; width: 100%; margin-top: 15px; gap: 10px;"
    },
    {
      "type": "text",
      "value": "@global.primary_crops_label",
      "style_list": "font-weight: 600; font-size: 18px; color: #333333; flex: 1;"
    },
    {
      "type": "audio",
      "name": "audio_select_cul",
      "parameter_list": "variant: button_only; src: audio/postSemi/select_culture_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "flex-shrink: 0;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.primary_crops_hint",
      "style_list": "font-style: italic; color: #666666; font-size: 13px; margin-bottom: 15px;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.cultures_primaires"
    },
    {
      "type": "begin_display_group",
      "name": "card_culture",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #ddd; border-radius: 10px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:100px; height:100px; "
    },
    {
      "name": "v_key",
      "value": "@calc('cul_' + @item.name)"
    },
    {
      "type": "simple_checkbox",
      "name": "checkbox",
      "value": "@field.@local.v_key",
      "action_list": "changed | set_field: @local.v_key: @local.checkbox;",
      "parameter_list": "label_text: @item.text; reverse: true;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "name": "autre_prim_1",
      "parameter_list": "style: column",
      "condition": "@field.cul_autre_1"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.sc_name_1_label",
      "style_list": "font-size: 14px; font-weight: 600; color: #333333; flex: 1;"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only; \nsrc: audio/postSemi/nom_autre_pcult1_fr.mp3; \nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.primay_crops_sc",
      "style_list": "font-size: 12px; color: #718096; font-style: italic;"
    },
    {
      "type": "image",
      "value": "images/autre_cult_1.jpg",
      "style_list": "width: 40%; object-fit: contain; "
    },
    {
      "type": "text_box",
      "name": "autre_culture_primaire_1",
      "value": "@field.autre_culture_primaire_1",
      "action_list": "changed | set_field: autre_culture_primaire_1 : this.value;",
      "parameter_list": "placeholder: Nom de la culture...;"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@calc(@field.cul_autre_1 && (@field.autre_culture_primaire_1 == '' || @field.autre_culture_primaire_1 == null))",
      "style_list": "color: #d71920; font-size: 12px; font-weight: bold; margin-top: 4px;"
    },
    {
      "type": "text",
      "value": "@global.list_crops_exist\n",
      "condition": "@calc(@field.cul_autre_1 && !!@field.autre_culture_primaire_1 && ['mais','mil','sorgho','coton','arachide','fourrage'].includes(@field.autre_culture_primaire_1.toLowerCase().trim()))",
      "style_list": "color: #d71920; font-size: 12px; font-weight: bold; margin-top: 4px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "autre_prim_2",
      "parameter_list": "style : column",
      "condition": "@field.cul_autre_2 ",
      "style_list": "display: block; width: 100%; background: #f7fafc; padding: 15px; margin-top: 15px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.sc_name_2_label",
      "style_list": "font-size: 14px; font-weight: 600; color: #333333; flex: 1;"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only; \nsrc: audio/postSemi/nom_autre_pcult2_fr.mp3; \nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.primay_crops_sc",
      "style_list": "font-size: 12px; color: #718096; font-style: italic;"
    },
    {
      "type": "image",
      "value": "images/autre_cult_2.jpg",
      "style_list": "width: 40%; object-fit: contain; "
    },
    {
      "type": "text_box",
      "name": "autre_culture_primaire_2",
      "value": "@field.autre_culture_primaire_2",
      "action_list": "changed | set_field: autre_culture_primaire_2 : this.value;",
      "parameter_list": "placeholder: Nom de la culture...;"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@calc(@field.cul_autre_2 && @local.v_autre_1_clean_ok && (@field.autre_culture_primaire_2 == '' || @field.autre_culture_primaire_2 == null))",
      "style_list": "color: #d71920; font-size: 12px; font-weight: bold; margin-top: 4px;"
    },
    {
      "type": "text",
      "value": "@global.list_crops_exist_primary",
      "condition": "@calc(@field.cul_autre_2 && !!@field.autre_culture_primaire_2 && (['mais','mil','sorgho','coton','arachide','fourrage'].includes(@field.autre_culture_primaire_2.toLowerCase().trim()) || (!!@field.autre_culture_primaire_1 && @field.autre_culture_primaire_1.toLowerCase().trim() == @field.autre_culture_primaire_2.toLowerCase().trim())))",
      "style_list": "color: #d71920; font-size: 12px; font-weight: bold; margin-top: 4px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "error_select",
      "value": "@global.error_required_answer",
      "condition": "!@local.completed_enabled",
      "style_list": "color: #d71920; background: #fff5f5; padding: 12px; font-size: 13px; margin-top: 15px; text-align: center; font-weight: 600;"
    },
    {
      "name": "v_autre_1_clean_ok",
      "value": "@calc(!@field.cul_autre_1 || (!!@field.autre_culture_primaire_1 && !['mais','mil','sorgho','coton','arachide','fourrage'].includes(@field.autre_culture_primaire_1.toLowerCase().trim())))"
    },
    {
      "name": "v_autre_2_clean_ok",
      "value": "@calc(!@field.cul_autre_2 || (!!@field.autre_culture_primaire_2 && !['mais','mil','sorgho','coton','arachide','fourrage'].includes(@field.autre_culture_primaire_2.toLowerCase().trim()) && @field.autre_culture_primaire_1.toLowerCase().trim() !== @field.autre_culture_primaire_2.toLowerCase().trim()))"
    },
    {
      "name": "v_list_prim",
      "value": "@calc([@field.cul_mais?'mais':null,@field.cul_mil?'mil':null,@field.cul_sorgho?'sorgho':null,@field.cul_coton?'coton':null,@field.cul_arachide?'arachide':null,@field.cul_fourrage?'fourrage':null,@field.cul_autre_1?@field.autre_culture_primaire_1:null,@field.cul_autre_2?@field.autre_culture_primaire_2:null].filter(v=>v!==null))"
    },
    {
      "name": "v_prim_filled",
      "value": "@calc(@local.v_autre_1_clean_ok && @local.v_autre_2_clean_ok)"
    },
    {
      "name": "completed_enabled",
      "value": "@local.v_list_prim && @local.v_prim_filled"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "Continuer",
      "action_list": "click | set_field: selected_cultures_list : @local.v_list_prim.join(',');\nclick | set_field: total_cultures_selected : @local.v_list_prim.length;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.v_list_prim.length > 0",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
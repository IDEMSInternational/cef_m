{
  "flow_type": "template",
  "flow_name": "depenses_page5",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.enfant_scolarise"
    },
    {
      "type": "audio",
      "name": "audio_5_2",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/on_education_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.enfants_scolarise_oui_hint ",
      "style_list": "@global.hint_style"
    },
    {
      "type": "begin_radio_list",
      "name": "enfants_scolarise_oui",
      "value": "@fields.enfants_scolarise_oui",
      "action_list": "changed | set_field : enfants_scolarise_oui: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.enfants_scolarise_oui && @fields.attempt_submit",
      "style_list": "@reponse_style"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.enfants_scolarise_oui == 'oui'"
    },
    {
      "type": "subtitle",
      "value": "@global.niveau_scolaire_enfant"
    },
    {
      "type": "audio",
      "name": "audio_5_3",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/select_niveaux_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_data_items",
      "value": "@data.niveau_scolaire",
      "condition": "@fields.enfants_scolarise_oui == 'oui'"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0"
    },
    {
      "type": "simple_checkbox",
      "name": "@item.name",
      "value": "@fields.@item.name",
      "action_list": "changed | set_field: @item.name: !@fields.@item.name;",
      "parameter_list": "label_text: @item.text;",
      "style_list": "margin-bottom: 10px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "name": "valid_type_scolarite",
      "value": "@calc(@fields.premier_cycle || @fields.second_cycle || @fields.lycee_professionnelle || @fields.universite)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@local.valid_type_scolarite && @fields.attempt_submit",
      "style_list": "@global.hint_style"
    },
    {
      "name": "select_niveau_scolaire",
      "value": "@calc([@fields.premier_cycle ? 'premier_cycle' : null,@fields.second_cycle ? 'second_cycle' : null,@fields.lycee_professionnelle ? 'lycee_professionnelle' : null,@fields.universite ? 'universite' : null].filter(v => v !== null).join(','))"
    },
    {
      "name": "select_niveau_scolaire_count",
      "value": "@calc([@fields.premier_cycle,@fields.second_cycle,@fields.lycee_professionnelle,@fields.universite].filter(v=>!!v).length)"
    },
    {
      "name": "niveau_scolaire_loop_idx",
      "value": "@calc(Number(0))"
    },
    {
      "name": "current_niveau_scolaire",
      "value": "@calc([@fields.premier_cycle ? 'premier_cycle' : null,@fields.second_cycle ? 'second_cycle' : null,@fields.lycee_professionnelle ? 'lycee_professionnelle' : null,@fields.universite ? 'universite' : null].filter(v => v !== null).at(Number(@local.niveau_scolaire_loop_idx)) || '')"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.enfants_scolarise_oui && valid_type_scolarite"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_5_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_5_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_5_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: select_niveau_scolaire: @local.select_niveau_scolaire;\nclick | set_field: select_niveau_scolaire_count: @local.select_niveau_scolaire_count;\nclick | set_field: niveau_scolaire_loop_idx: @local.niveau_scolaire_loop_idx;\nclick | set_field: current_niveau_scolaire: @local.current_niveau_scolaire;\n\nclick | set_field: attempt_submit: false;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled && @fields.enfants_scolarise_oui == 'oui'",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_5_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: select_niveau_scolaire: @local.select_niveau_scolaire;\nclick | set_field: select_niveau_scolaire_count: @local.select_niveau_scolaire_count;\nclick | set_field: niveau_scolaire_loop_idx: @local.niveau_scolaire_loop_idx;\nclick | set_field: current_niveau_scolaire: @local.current_niveau_scolaire;\n\nclick | set_data | _list_id: depenses_settings_pages, _index: 5, completed: true;\nclick | set_data | _list_id: depenses_settings_pages, _index: 6, completed: true;\nclick | set_data | _list_id: depenses_settings_pages, _index: 7, completed: true;\nclick | set_data | _list_id: depenses_settings_pages, _index: 8, completed: true;\n",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@fields.enfants_scolarise_oui == 'non' && @local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    },
    {
      "parameter_list": "\n\n"
    }
  ]
}
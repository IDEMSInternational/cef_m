{
  "flow_type": "template",
  "flow_name": "depenses_page8",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.montant_previsionnel_note"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.frais_totaux_annuel_hint"
    },
    {
      "type": "audio",
      "name": "audio_8_1",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/education_totaux_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "frais_education_annuel",
      "value": "@calc(Number(@fields.totaux_frais_education_premier_cycle || 0) + Number(@fields.totaux_frais_education_second_cycle || 0) + Number(@fields.totaux_frais_education_lycee_professionnelle || 0) + Number(@fields.totaux_frais_education_universite || 0))"
    },
    {
      "name": "frais_education_annuel_cfa",
      "value": "@calc(Number(@local.frais_education_annuel || 0) * 5)"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "style_list": "background-color: #C8E6C9; border: 3px solid #2E7D32; border-radius: 12px; text-align: center; "
    },
    {
      "type": "text",
      "value": "@global.frais_totaux_niveau_enfants",
      "style_list": "font-size: 16px; color: #6D4C41;"
    },
    {
      "type": "text",
      "value": "@local.frais_education_annuel drm ",
      "style_list": "background: #E8F5E9; border-radius: 10px; color: #2E7D32; font-weight: bold; font-size: 20px;"
    },
    {
      "type": "text",
      "value": "**@local.frais_education_annuel_cfa FCFA**"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_8_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page8_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: frais_education_annuel: @local.frais_education_annuel;\nclick | emit: completed;",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
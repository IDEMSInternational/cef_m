{
  "flow_type": "template",
  "flow_name": "cultures_page7",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_data_items",
      "value": "@data.planif_cultures_primaires",
      "parameter_list": "filter: @item.name == @fields.culture_label"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "**@item.text**"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "title",
      "value": "@global.type_engrais_prevu"
    },
    {
      "type": "text",
      "value": "@global.type_engrais_prevu_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "begin_data_items",
      "value": "@data.type_engrais",
      "parameter_list": "style: column; "
    },
    {
      "type": "simple_checkbox",
      "name": "@item.name",
      "value": "@fields.@item.name",
      "action_list": "changed | set_field: @item.name: !@fields.@item.name;",
      "parameter_list": "label_text: @item.text; reverse: false; align: left; ",
      "style_list": "margin-bottom: 10px;"
    },
    {
      "type": "end_data_items"
    },
    {
      "name": "valid_type_engrais",
      "value": "@calc(@fields.npk_coton_14_18_18 || @fields.npk_cereale_15_15_15 || @fields.npk_cereale_17_17_17 || @fields.dap || @fields.uree || @fields.autre_engrais || @fields.aucun_engrais)"
    },
    {
      "name": "valid_select_engrais_aucun",
      "value": "@calc((@fields.npk_coton_14_18_18 || @fields.npk_cereale_15_15_15 || @fields.npk_cereale_17_17_17 || @fields.dap || @fields.uree || @fields.autre_engrais) && @fields.aucun_engrais)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@local.valid_type_engrais",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.type_engrais_error",
      "condition": "@fields.attempt_submit && @local.valid_select_engrais_aucun",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@fields.autre_engrais"
    },
    {
      "type": "text",
      "value": "@global.engrais_mineral"
    },
    {
      "type": "image",
      "value": "images/ecrire.jpg",
      "style_list": "width: 40%; object-fit: contain; "
    },
    {
      "type": "text_box",
      "name": "precision_autre_engrais",
      "value": "@fields.precision_autre_engrais",
      "action_list": "changed | set_field : precision_autre_engrais: this.value;",
      "parameter_list": "number_input: true"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_type_engrais && !@local.valid_select_engrais_aucun",
      "parameter_list": "precision_autre_engrais"
    },
    {
      "type": "set_field",
      "name": "liste_type_engrais_select",
      "value": "@calc([@fields.npk_coton_14_18_18 ? 'npk_coton_14_18_18' : null, @fields.npk_cereale_15_15_15 ? 'npk_cereale_15_15_15' : null, @fields.npk_cereale_17_17_17 ? 'npk_cereale_17_17_17' : null, @fields.dap ? 'dap' : null, @fields.uree ? 'uree' : null, @fields.autre_engrais ? 'autre_engrais' : null,@fields.aucun_engrais ? 'aucun_engrais' : null].filter(v => v !== null).join(','))",
      "condition": "@local.completed_enabled"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_7_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_7_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_7_btn_continue",
      "value": "Continuer",
      "action_list": "click | set_field: liste_type_engrais_select_@fields.culture_label : @fields.liste_type_engrais_select;\nclick | set_field: precision_autre_engrais_@fields.culture_label : @fields.precision_autre_engrais;\n\nclick | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "superficie_champs_page10",
  "status": "released",
  "rows": [
    {
      "name": "valid_cult_asso",
      "value": "@calc(!!@fields.cult_asso && String(@fields.cult_asso).trim() !== '')"
    },
    {
      "name": "valid_autre_text1",
      "value": "@calc(@fields.cult_asso !== 'autre_culture1' || (!!@fields.autre_cult_asso1 && String(@fields.autre_cult_asso1).trim() !== ''))"
    },
    {
      "name": "valid_autre_text2",
      "value": "@calc(@fields.cult_asso !== 'autre_culture2' || (!!@fields.autre_cult_asso1 && String(@fields.autre_cult_asso1).trim() !== '' && !!@fields.autre_cult_asso2 && String(@fields.autre_cult_asso2).trim() !== ''))"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(!!@fields.association_oui_non && (@fields.association_oui_non === 'non' || (@fields.association_oui_non === 'oui' && @local.valid_cult_asso && @local.valid_autre_text1 && @local.valid_autre_text2)))"
    },
    {
      "name": "cult_asso_selected",
      "value": "@calc(@fields.cult_asso === 'autre_culture1' ? (@fields.autre_cult_asso1 || '') : @fields.cult_asso === 'autre_culture2' ? (@fields.autre_cult_asso2 || '') : (@fields.cult_asso || ''))"
    },
    {
      "type": "title",
      "value": "**ASSOCIATION DE CULTURES DANS LA PARCELLE  N⁰@fields.num_parcelle DE @fields.nom_champ**"
    },
    {
      "type": "begin_data_items",
      "name": "card_1",
      "value": "@data.cult_princip",
      "parameter_list": "filter: @item.name == @fields.cult_princip"
    },
    {
      "type": "begin_display_group",
      "name": "culture"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width: 80%; object-fit: contain;\n"
    },
    {
      "type": "text",
      "value": "@global.cult_princ",
      "style_list": "font-size: 16px; font-weight: bold; color: #1e3656;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "name": "card"
    },
    {
      "type": "text",
      "value": "@global.note_cult_asso_oui_non",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/asso_yesno_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "card_2\n",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;"
    },
    {
      "type": "image",
      "value": "images/association.jpg",
      "style_list": "width: 50%; object-fit: contain;"
    },
    {
      "type": "radio_button_grid",
      "name": "association_oui_non\n",
      "value": "@fields.association_oui_non\n",
      "action_list": "changed | set_field: association_oui_non\n: this.value;",
      "parameter_list": "answer_list: @data.oui_non;\nvariant: flex; item_width: 100px; grid_gap: 10px; style: secondary;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "name": "html_text",
      "value": "@global.select_warring",
      "condition": "@fields.attempt_submit_p11 && !@fields.association_oui_non",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "name": "card_3",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "text",
      "value": "@global.hint_cult_asso",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/cult_asso_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "card_4",
      "condition": "@fields.association_oui_non == 'oui'"
    },
    {
      "type": "radio_button_grid",
      "name": "cult_asso\n",
      "value": "@fields.cult_asso\n\n",
      "action_list": "changed | set_field: cult_asso: this.value;\n",
      "parameter_list": "answer_list: @data.culture_association;\nitem_width: 80px;\ngrid_width: 150%;\ngrid_gap: 10px;\nvariant: circle-icon;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "card_5",
      "condition": "@fields.cult_asso== 'autre_culture1' && @fields.association_oui_non == 'oui'",
      "style_list": "display: block; width: 100%; margin-top: 15px; padding: 12px; "
    },
    {
      "type": "text",
      "value": "@global.cult.asso1",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/autre_cult_nom1_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "text_box",
      "name": "autre_cult_asso1",
      "value": "@fields.autre_cult_asso1",
      "action_list": "changed | set_field: autre_cult_asso1 : this.value;",
      "parameter_list": "max_length: 30;\nplaceholder: Entrez le nom de la culture;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.message_other_cult",
      "condition": "@fields.attempt_submit_p11 && @fields.association_oui_non == 'oui' && @fields.cult_asso==  'autre_culture1' && !@fields.autre_cult_asso1",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "name": "card_6",
      "condition": "@fields.autre_cult_asso1 && @fields.association_oui_non == 'oui' && @fields.cult_asso==  'autre_culture2'",
      "style_list": "display: block; width: 100%; margin-top: 15px; padding: 12px;"
    },
    {
      "type": "text",
      "value": "@global.cult_asso2",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_11_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/autre_cult_nom2_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "text_box",
      "name": "autre_cult_asso2",
      "value": "@fields.autre_cult_asso2",
      "action_list": "changed | set_field: autre_cult_asso2 : this.value;",
      "parameter_list": "max_length: 30;\nplaceholder: Entrez le nom de la culture;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.message_other_cult",
      "condition": "@fields.attempt_submit_p11 && @fields.association_oui_non == 'oui' && @fields.autre_culture2 == true && !@fields.autre_cult_asso2",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "name": "card_7",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page11_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page11_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('association_parcelle_N' + @fields.num_parcelle) : @fields.association_oui_non;\nclick | set_field: @calc('cult_asso_selected_parcelle_N' + @fields.num_parcelle) : @local.cult_asso_selected;\nclick | set_field: @calc('autre_cult_asso1_parcelle_N' + @fields.num_parcelle) : @fields.autre_cult_asso1;\nclick | set_field: @calc('autre_cult_asso2_parcelle_N' + @fields.num_parcelle) : @fields.autre_cult_asso2; \nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
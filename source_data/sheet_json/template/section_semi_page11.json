{
  "flow_type": "template",
  "flow_name": "section_semi_page11",
  "status": "released",
  "rows": [
    {
      "name": "v_nom_valide",
      "value": "@calc((@field.nom_autre_cout_semis || '').trim().length > 0)"
    },
    {
      "name": "v_mt_fmt",
      "value": "@calc(/^\\d+$/.test(@field.autre_cout_semis))"
    },
    {
      "name": "v_mt_err",
      "value": "@calc(!@local.v_mt_fmt || Number(@field.autre_cout_semis) < 0)"
    },
    {
      "name": "v_page9_valid",
      "value": "@calc(@field.no_autre_cout_semis == 'non' || (@field.no_autre_cout_semis == 'oui' && @local.v_nom_valide && !@local.v_mt_err))"
    },
    {
      "name": "v_current_human",
      "value": "@calc(Number(@field.current_culture_index) + 1)"
    },
    {
      "type": "begin_display_group",
      "name": "header_top",
      "style_list": "background: #00adcc; padding: 15px; border-radius: 0 0 15px 15px; margin-bottom: 20px;"
    },
    {
      "type": "text",
      "value": "CULTURE @local.v_current_human / @field.total_cultures_selected",
      "style_list": "color: white; font-weight: bold; font-size: 14px; text-transform: uppercase;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@field.active_culture_name || '').toLowerCase().trim()) ? 'images/' + @field.active_culture_name + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60%; object-fit: contain;"
    },
    {
      "type": "text",
      "value": "Culture : @field.active_culture_name",
      "style_list": "font-weight: bold; font-size: 18px; color: #e3a730; margin-top: 10px; text-align: center;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.lbl_section_title_11",
      "style_list": "color: #e67e22; font-weight: bold; font-size: 14px; margin-bottom: 10px;"
    },
    {
      "type": "begin_display_group",
      "name": "grp_question_existence",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_exist_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/on_autre_cout_semis_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.info_other_count"
    },
    {
      "type": "radio_button_grid",
      "name": "no_autre_cout_semis",
      "value": "@field.no_autre_cout_semis",
      "action_list": "changed | set_field: no_autre_cout_semis: this.value;",
      "parameter_list": "answer_list: @data.oui_non;\nvariant: flex;\nstyle: secondary;\nitem_width: 60px;\ngrid_gap: 8px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: colum",
      "condition": "@field.no_autre_cout_semis == 'oui'",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.lbl_exist_label",
      "style_list": "font-weight: bold; font-size: 14px; color: #333333; flex: 1;"
    },
    {
      "type": "audio",
      "name": "note_autre_cout_semi",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/nom_autre_cout_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/ecrire.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "nom_autre_cout_semis",
      "value": "@field.nom_autre_cout_semis",
      "action_list": "changed | set_field: nom_autre_cout_semis: this.value;",
      "parameter_list": "placeholder: Nom des coûts...;"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@calc(@field.no_autre_cout_semis == 'oui' && (@field.nom_autre_cout_semis == ' ' || @field.nom_autre_cout_semis == null))",
      "style_list": "color: red; font-size: 12px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_montant_autre_err",
      "value": "@calc(!/^\\d+(\\.\\d+)?$/.test(@field.autre_cout_semis) || Number(@field.autre_cout_semis) < 0)"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: colum",
      "condition": "@field.no_autre_cout_semis == 'oui' && @fields.nom_autre_cout_semis",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.autre_cout_semis\n",
      "style_list": "font-weight: bold; font-size: 14px; color: #333333; flex: 1;"
    },
    {
      "type": "audio",
      "name": "note_autre_cout_semis1",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/autre_cout_semis_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.info_count",
      "style_list": "font-style: italic; color: #666; font-size: 12px;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "autre_cout_semis",
      "value": "@field.autre_cout_semis",
      "action_list": "changed | set_field: autre_cout_semis: this.value;",
      "parameter_list": "number_input: true; placeholder: Montant en Dram...;"
    },
    {
      "type": "text",
      "value": "@global.error_positive_value",
      "condition": "@calc(@field.no_autre_cout_semis == 'oui' && @local.v_montant_autre_err)",
      "style_list": "color: red; font-size: 12px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_final_autre_cout",
      "value": "@calc(@field.no_autre_cout_semis == 'oui' ? (Number(@field.autre_cout_semis) || 0) : 0)"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: autre_cout_semis_total : @local.v_final_autre_cout;\n\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.v_page9_valid",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
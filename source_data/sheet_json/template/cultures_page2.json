{
  "flow_type": "template",
  "flow_name": "cultures_page2",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.cult_prevues"
    },
    {
      "type": "audio",
      "name": "audio_2_1",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/select_culture_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.note_cult_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "begin_data_items",
      "value": "@data.planif_cultures_primaires",
      "style_list": "display: flex; flex-wrap: wrap; justify-content: space-between; width: 90%; gap: 10px;"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0"
    },
    {
      "name": "cult_name",
      "value": "@calc('culture_' + @item.name)"
    },
    {
      "type": "simple_checkbox",
      "name": "check_cult",
      "value": "@fields.@local.cult_name",
      "action_list": "changed | set_field: @local.cult_name: @local.check_cult;",
      "parameter_list": "label_text: @item.text; reverse: false; align: center; ",
      "style_list": "margin-bottom: 10px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@fields.culture_autre_cult_1"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.autre_cult_label"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/cult_autre_nom1_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.autre_cult_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "image",
      "value": "images/autre_cult_1.jpg",
      "style_list": "width: 40%; object-fit: contain; "
    },
    {
      "type": "text_box",
      "name": "nom_culture_1",
      "value": "@fields.nom_culture_1",
      "action_list": "changed | set_field: nom_culture_1 : this.value;",
      "parameter_list": "placeholder: @global.texte_placeholder;"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire ",
      "condition": "@calc(@fields.culture_autre_cult_1 && (@fields.nom_culture_1 == '' || @fields.nom_culture_1 == null))",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.culture_existant",
      "condition": "@calc(@fields.culture_autre_cult_1 && !!@fields.nom_culture_1 && ['mais','mil','sorgho','coton','arachide','fourrage', 'niebe','soja','fonio','riz','sesame','wouandzou','patate_douce','bissap'].includes(@fields.nom_culture_1.toLowerCase().trim()))",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@fields.culture_autre_cult_2"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.autre_cult_label2"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/cult_autre_nom2_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.autre_cult_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "image",
      "value": "images/autre_cult_2.jpg",
      "style_list": "width: 40%; object-fit: contain; "
    },
    {
      "type": "text_box",
      "name": "nom_culture_2",
      "value": "@fields.nom_culture_2",
      "action_list": "changed | set_field: nom_culture_2 : this.value;",
      "parameter_list": "placeholder: @global.texte_placeholder;"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire ",
      "condition": "@calc(@fields.culture_autre_cult_2 && (@fields.nom_culture_2 == '' || @fields.nom_culture_2 == null))",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.culture_existant",
      "condition": "@calc(@fields.culture_autre_cult_2 && !!@fields.nom_culture_2 && ['mais','mil','sorgho','coton','arachide','fourrage', 'niebe','soja','fonio','riz','sesame','wouandzou','patate_douce','bissap'].includes(@fields.nom_culture_2.toLowerCase().trim()))",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "liste_cult_select",
      "value": "@calc([@fields.culture_mais ? 'mais' : null, @fields.culture_mil ? 'mil' : null, @fields.culture_sorgho ? 'sorgho' : null, @fields.culture_coton ? 'coton' : null, @fields.culture_arachide ? 'arachide' : null, @fields.culture_fourrage ? 'fourrage' : null, @fields.culture_niebe ? 'niebe' : null, @fields.culture_soja ? 'soja' : null, @fields.culture_fonio ? 'fonio' : null, @fields.culture_riz ? 'riz' : null, @fields.culture_sesame ? 'sesame' : null, @fields.culture_wouandzou ? 'wouandzou' : null, @fields.culture_patate_douce ? 'patate_douce' : null, @fields.culture_bissap ? 'bissap' : null, @fields.culture_autre_cult_1 ? @fields.nom_culture_1 : null, @fields.culture_autre_cult_2 ? @fields.nom_culture_2: null].filter(v => v !== null).join(','))"
    },
    {
      "name": "valid_cult_select",
      "value": "@calc(@fields.culture_mais || @fields.culture_mil || @fields.culture_sorgho || @fields.culture_coton || @fields.culture_arachide || @fields.culture_fourrage || @fields.culture_niebe || @fields.culture_soja || @fields.culture_fonio || @fields.culture_riz || @fields.culture_sesame || @fields.culture_wouandzou || @fields.culture_patate_douce || @fields.culture_bissap || @fields.culture_autre_cult_1 || @fields.culture_autre_cult_2)",
      "action_list": "\n\n\n\n\n"
    },
    {
      "name": "culture_loop_idx",
      "value": "@calc(Number(0))"
    },
    {
      "name": "culture_label",
      "value": "@calc([@fields.culture_mais ? 'mais' : null, @fields.culture_mil ? 'mil' : null, @fields.culture_sorgho ? 'sorgho' : null, @fields.culture_coton ? 'coton' : null, @fields.culture_arachide ? 'arachide' : null, @fields.culture_fourrage ? 'fourrage' : null, @fields.culture_niebe ? 'niebe' : null, @fields.culture_soja ? 'soja' : null, @fields.culture_fonio ? 'fonio' : null, @fields.culture_riz ? 'riz' : null, @fields.culture_sesame ? 'sesame' : null, @fields.culture_wouandzou ? 'wouandzou' : null, @fields.culture_patate_douce ? 'patate_douce' : null, @fields.culture_bissap ? 'bissap' : null, @fields.culture_autre_cult_1 ? 'autre_cult_1' : null, @fields.culture_autre_cult_2 ? 'autre_cult_2' : null].filter(v => v !== null).at(Number(@local.culture_loop_idx)) || '')"
    },
    {
      "name": "liste_cult_select_count",
      "value": "@calc([@fields.culture_mais,@fields.culture_mil,@fields.culture_sorgho,@fields.culture_coton,@fields.culture_arachide,@fields.culture_fourrage,@fields.culture_niebe,@fields.culture_soja,@fields.culture_fonio,@fields.culture_riz,@fields.culture_sesame,@fields.culture_wouandzou,@fields.culture_patate_douce,@fields.culture_bissap,@fields.culture_autre_cult_1,@fields.culture_autre_cult_2].filter(v=>!!v).length)"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_cult_select "
    },
    {
      "type": "text",
      "value": "@global.error_select",
      "condition": "!@local.valid_cult_select",
      "style_list": "color: #d71920; background: #fff5f5; padding: 12px; font-size: 13px; margin-top: 15px; text-align: center; font-weight: 600;"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_2_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_2_btn_attempt_submit",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_2_btn_continue",
      "value": "Continuer",
      "action_list": "click | set_field: liste_cult_select : @local.liste_cult_select;\nclick | set_field: liste_cult_select_count : @local.liste_cult_select_count;\nclick | set_field: culture_loop_idx : @local.culture_loop_idx;\nclick | set_field: culture_label : @local.culture_label;\nclick | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "recolte_page4",
  "status": "released",
  "rows": [
    {
      "name": "v_current_human",
      "value": "@calc(Number(@field.current_culture_index) + 1)"
    },
    {
      "type": "begin_display_group",
      "name": "header",
      "style_list": "background: #00adcc; padding: 15px; border-radius: 0 0 15px 15px; margin-bottom: 20px;"
    },
    {
      "type": "text",
      "value": "CULTURE @local.v_current_human / @field.total_cultures_selected",
      "style_list": "color: white; font-weight: bold; font-size: 14px; text-transform: uppercase;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_has_file",
      "value": "@calc(['coton', 'mais', 'mil', 'sorgho', 'arachide', 'fourrage'].includes(@local.v_crop_clean))"
    },
    {
      "name": "v_crop_clean",
      "value": "@calc((@field.active_culture_name || '').toLowerCase().trim())"
    },
    {
      "name": "v_res_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.production_residu_culture))"
    },
    {
      "name": "v_res_err",
      "value": "@calc(!@local.v_res_fmt || Number(@field.production_residu_culture) < 0)"
    },
    {
      "name": "v_fane_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.nombre_botte))"
    },
    {
      "name": "v_has_residu",
      "value": "@calc(['coton', 'mais', 'mil', 'sorgho', 'riz', 'fonio', 'fourrage'].includes(@local.v_crop_clean))"
    },
    {
      "name": "v_has_fane",
      "value": "@calc(['arachide', 'fourrage', 'niebe', 'soja', 'wouandzou', 'patate', 'patate_douce'].includes(@local.v_crop_clean))"
    },
    {
      "name": "v_fane_err",
      "value": "@calc(!@local.v_fane_fmt || Number(@field.nombre_botte) < 0)"
    },
    {
      "type": "text",
      "value": "@global.title_page_3",
      "style_list": "font-weight: bold; font-size: 16px; margin-bottom: 10px"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@field.active_culture_name || '').toLowerCase().trim()) ? 'images/' + @field.active_culture_name + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60%; object-fit: contain;"
    },
    {
      "type": "text",
      "value": "Culture : @field.active_culture_name",
      "style_list": "font-weight: bold; font-size: 18px; color: #e3a730; margin-top: 10px; text-align: center;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "grp_residus",
      "condition": "@local.v_has_residu",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_residu",
      "parameter_list": "variant: button_only;\nsrc: audio/recolte/production_residu_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.tlbl_res",
      "style_list": "font-weight: bold; font-size: 14px; color: #333; ma"
    },
    {
      "type": "image",
      "value": "images/charrette.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box",
      "name": "production_residu_culture",
      "value": "@field.production_residu_culture",
      "action_list": "changed | set_field: production_residu_culture : this.value;",
      "parameter_list": "number_input: true;    placeholder: Nombre de charretées;"
    },
    {
      "type": "text",
      "value": "@global.error_positive_value",
      "condition": "@local.v_res_err",
      "style_list": "font-size: 12px; color: red;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "grp_fanes",
      "condition": "@local.v_has_fane",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_residu",
      "parameter_list": "variant: button_only;\nsrc: audio/recolte/production_fane_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.lbl_fane",
      "style_list": "font-weight: bold; font-size: 16px; color: #333; margin-bottom: 5px;"
    },
    {
      "type": "image",
      "value": "images/botte.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box ",
      "name": "nombre_botte",
      "value": "@field.nombre_botte",
      "action_list": "changed | set_field: nombre_botte : this.value;",
      "parameter_list": "number_input: true;    placeholder: Nombre de bottes;"
    },
    {
      "type": "text",
      "value": "@global.error_positive_value",
      "condition": "@local.v_fane_err",
      "style_list": "font-size: 12px; color: red;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_page6_valid",
      "value": "@calc((!@local.v_has_residu || (@local.v_res_fmt && Number(@field.production_residu_culture || 0) >= 0)) && (!@local.v_has_fane || (@local.v_fane_fmt && Number(@field.nombre_botte || 0) >= 0))'"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed;",
      "parameter_list": "disabled: !@local.v_page6_valid",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
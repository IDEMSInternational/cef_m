{
  "flow_type": "template",
  "flow_name": "stabulation",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.stabulation_title"
    },
    {
      "type": "begin_data_items",
      "value": "@data.categorie_animaux",
      "parameter_list": "filter: @item.name == @fields.current_cat_animaux"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@item.text: @fields.nb_animaux tête(s)"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.stabulation_title_hint"
    },
    {
      "type": "end_data_items"
    },
    {
      "name": "stabulation_con",
      "value": "@calc((Number(@fields.nb_animaux || 0) * ({'boeufs_labour': 0, 'embouche_bovine': 4.5, 'vache_laitiere': 4.5, 'autres_bovins': 5, 'assins': 4.5, 'embouche_ovine': 1.1, 'reste_ovins': 2.3, 'caprins': 0}[@fields.current_cat_animaux] || 0)).toFixed(1))"
    },
    {
      "name": "stabulation_resid",
      "value": "@calc((Number(@fields.nb_animaux || 0) * ({'boeufs_labour': 0, 'embouche_bovine': 6.3, 'vache_laitiere': 5.4, 'autres_bovins': 0, 'assins': 3.6, 'embouche_ovine': 0, 'reste_ovins': 0, 'caprins': 0}[@fields.current_cat_animaux] || 0)).toFixed(1))"
    },
    {
      "name": "stabulation_fane",
      "value": "@calc((Number(@fields.nb_animaux || 0) * ({'boeufs_labour': 0, 'embouche_bovine': 120, 'vache_laitiere': 240, 'autres_bovins': 0, 'assins': 120, 'embouche_ovine': 90, 'reste_ovins': 180, 'caprins': 0}[@fields.current_cat_animaux] || 0)).toFixed(1))"
    },
    {
      "type": "text",
      "value": "@global.concentre_son_tourteau_hint"
    },
    {
      "type": "image",
      "value": "images/concentre.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "begin_display_group",
      "style_list": "background-color: #f0f4f8; border-left-style: solid; border-left-color: #0056b3; border-radius: 5px;"
    },
    {
      "type": "text",
      "value": "@global.concentre_son_tourteau_stabulation"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.residus_cereale_paille_hint"
    },
    {
      "type": "image",
      "value": "images/Residus.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "begin_display_group",
      "style_list": "background-color: #f0f4f8; border-left-style: solid; border-left-color: #0056b3; border-radius: 5px;"
    },
    {
      "type": "text",
      "value": "@global.residus_cereale_paille_stabulation"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.fane_cereale_hint"
    },
    {
      "type": "image",
      "value": "images/Fane2.jpg",
      "style_list": "width:120px; height:120px; "
    },
    {
      "type": "begin_display_group",
      "style_list": "background-color: #f0f4f8; border-left-style: solid; border-left-color: #0056b3; border-radius: 5px;"
    },
    {
      "type": "text",
      "value": "@global.fane_cereale_stabulation"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "set_field",
      "name": "stabulation_con_@fields.current_cat_animaux",
      "value": "@local.stabulation_con"
    },
    {
      "type": "set_field",
      "name": "stabulation_resid_@fields.current_cat_animaux",
      "value": "@local.stabulation_resid"
    },
    {
      "type": "set_field",
      "name": "stabulation_fane_@fields.current_cat_animaux",
      "value": "@local.stabulation_fane"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "section_semi_page5",
  "status": "released",
  "rows": [
    {
      "name": "v_current_human",
      "value": "@calc(Number(@field.current_culture_index) + 1)"
    },
    {
      "name": "v_fum_fmt",
      "value": "@calc(/^\\d+$/.test(@field.quantite_fumure_organique))"
    },
    {
      "name": "v_fum_err",
      "value": "@calc(!@local.v_fum_fmt || Number(@field.quantite_fumure_organique) < 0)"
    },
    {
      "name": "v_trans_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.cout_transport_nonzero))"
    },
    {
      "name": "v_trans_err",
      "value": "@calc(!@local.v_trans_fmt || Number(@field.cout_transport_nonzero) < 0)"
    },
    {
      "type": "begin_display_group",
      "name": "header",
      "style_list": "background: #00adcc; padding: 15px; border-radius: 0 0 15px 15px; margin-bottom: 20px;"
    },
    {
      "type": "text",
      "value": "CULTURE @local.v_current_human / @field.total_cultures_selected",
      "style_list": "color: white; font-weight: bold; font-size: 14px; text-transform: uppercase;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@field.active_culture_name || '').toLowerCase().trim()) ? 'images/' + @field.active_culture_name + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60%; object-fit: contain;"
    },
    {
      "type": "text",
      "value": "Culture : @field.active_culture_name",
      "style_list": "font-weight: bold; font-size: 18px; color: #e3a730; margin-top: 10px; text-align: center; color: #e3a730; margin-top: 10px; text-align: center;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.lbl_section_title",
      "style_list": "color: #e67e22; font-weight: bold; font-size: 14px; margin-bottom: 10px; display: block;"
    },
    {
      "type": "begin_display_group",
      "name": "grp_quantite_fumure",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_prod",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/Q_fumure_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.lbl_fumure_label",
      "style_list": "font-weight: bold; font-size: 14px; color: #333333; flex: 1;"
    },
    {
      "type": "text",
      "value": "@global.error_fumure",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/charrette.jpg",
      "style_list": "width: 40%; object-fit: contain;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_fumure_organique",
      "value": "@field.quantite_fumure_organique",
      "action_list": "changed | set_field: quantite_fumure_organique: this.value;",
      "parameter_list": "number_input: true;\n\nplaceholder: Nombre de charretées;"
    },
    {
      "type": "text",
      "value": "@global.error_positive_value",
      "condition": "@local.v_fum_err",
      "style_list": "font-size: 12px; color: red; margin-top: 4px;"
    },
    {
      "type": "begin_display_group",
      "name": "cout_trans_zero",
      "condition": "@calc(Number(@field.quantite_fumure_organique) == 0)",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_trans_z_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/cout_transport_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.lbl_trans_z_label",
      "style_list": "font-weight: bold; font-size: 14px; color: #333333; flex: 1;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "value": 0,
      "parameter_list": "disabled:true;"
    },
    {
      "type": "text",
      "value": "@global.error_fumure_val",
      "style_list": "font-size: 12px; color: #999;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "cout_trans_nonzero",
      "condition": "@calc(Number(@field.quantite_fumure_organique) > 0)",
      "style_list": "display: block; width: 100%"
    },
    {
      "type": "audio",
      "name": "aud_trans_z_fr",
      "parameter_list": "variant: button_only;\n\nsrc: audio/semis/cout_transport_fr.mp3;\n\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.lbl_trans_z_label",
      "style_list": "font-weight: bold; font-size: 14px; color: #333333; flex: 1;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "cout_transport_nonzero",
      "value": "@field.cout_transport_nonzero",
      "action_list": "changed | set_field: cout_transport_nonzero : this.value;",
      "parameter_list": "number_input: true;\n\nplaceholder: Montant en Dram;"
    },
    {
      "type": "text",
      "value": "@global.error_positive_value",
      "condition": "@local.v_trans_err",
      "style_list": "font-size: 12px; color: red; margin-top: 4px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_val_trans_nz",
      "value": "@calc(Number(@field.cout_transport_nonzero) || 0)"
    },
    {
      "name": "v_final_trans",
      "value": "@calc(Number(@field.quantite_fumure_organique) == 0 ? 0 : @local.v_val_trans_nz)"
    },
    {
      "name": "v_page3_valid",
      "value": "@calc(@local.v_fum_fmt && Number(@field.quantite_fumure_organique) >= 0 && (Number(@field.quantite_fumure_organique) == 0 || (@local.v_trans_fmt && Number(@field.cout_transport_nonzero) >= 0)))"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: cout_transport : @local.v_final_trans;\n\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.v_page3_valid",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
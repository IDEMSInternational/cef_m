    {
      "type": "title",
      "value": "@global.rendement_moyen_upa"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column;",
      "condition": "@fields.sac_mais != 0"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.rendement_moyen_mais"
    },
    {
      "type": "audio",
      "name": "audio_4_1",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/rdt_moyen_mais_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.rendement_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "image",
      "value": "images/mais.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "rend_moyen_mais",
      "value": "@fields.rend_moyen_mais",
      "action_list": "changed | set_field: rend_moyen_mais : this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;",
      "style_list": "margin: 10px;"
    },
    {
      "name": "valid_rend_moyen_mais",
      "value": "@calc((/^\\d+(\\.\\d+)?$/.test(@local.rend_moyen_mais) && Number(@local.rend_moyen_mais) > 0) || !@local.rend_moyen_mais)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.rend_moyen_mais && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.erreur_rendement",
      "condition": "!@local.valid_rend_moyen_mais",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "end_display_group"
    },

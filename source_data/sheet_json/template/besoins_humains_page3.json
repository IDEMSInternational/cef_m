{
  "flow_type": "template",
  "flow_name": "besoins_humains_page3",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.repartition_besoin_cereale"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group",
      "name": "recap_besoin",
      "style_list": "padding: 15px; text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.repartition_besoin_cereale_hint",
      "style_list": "font-size: 12px; font-weight: bold; text-transform: uppercase;"
    },
    {
      "type": "text",
      "value": "@fields.besoin_cereale_exploitation sacs",
      "style_list": "font-size: 24px; font-weight: bold;color: blue;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.repartition_besoin_cereale_attention",
      "style_list": "@global.hint_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.nbre_sac_mais"
    },
    {
      "type": "audio",
      "name": "audio_3_1",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/sac_mais_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sac_mais.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "sac_mais",
      "value": "@fields.sac_mais",
      "action_list": "changed | set_field: sac_mais : this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;",
      "style_list": "margin: 10px;"
    },
    {
      "name": "valid_sac_mais",
      "value": "@calc((/^\\d+(\\.\\d+)?$/.test(@local.sac_mais) && Number(@local.sac_mais) < @fields.besoin_cereale_exploitation) || !@local.sac_mais)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.sac_mais && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.erreur_sacs",
      "condition": "!@local.valid_sac_mais",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.nbre_sac_mil"
    },
    {
      "type": "audio",
      "name": "audio_3_2",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/sac_mil_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sac_mil.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "sac_mil",
      "value": "@field.sac_mil",
      "action_list": "changed | set_field: sac_mil : this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;",
      "style_list": "margin: 10px;"
    },
    {
      "name": "valid_sac_mil",
      "value": "@calc((/^\\d+(\\.\\d+)?$/.test(@local.sac_mil) && Number(@local.sac_mil) < @fields.besoin_cereale_exploitation) || !@local.sac_mil)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.sac_mil && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.erreur_sacs",
      "condition": "!@local.valid_sac_mil",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.nbre_sac_sorgho"
    },
    {
      "type": "audio",
      "name": "audio_3_3",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/sac_sorgho_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sac_sorgho.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "sac_sorgho",
      "value": "@field.sac_sorgho",
      "action_list": "changed | set_field: sac_sorgho : this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;",
      "style_list": "margin: 10px;"
    },
    {
      "name": "valid_sac_sorgho",
      "value": "@calc((/^\\d+(\\.\\d+)?$/.test(@local.sac_sorgho) && Number(@local.sac_sorgho) < @fields.besoin_cereale_exploitation) || !@local.sac_sorgho)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.sac_sorgho && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.erreur_sacs",
      "condition": "!@local.valid_sac_sorgho",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.nbre_sac_riz"
    },
    {
      "type": "audio",
      "name": "audio_3_4",
      "parameter_list": "variant: button_only;\nsrc: audio/alimentationHumaine/sac_riz_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sac_riz.jpg",
      "style_list": "width:100px; height:100px;"
    },
    {
      "type": "text_box",
      "name": "sac_riz",
      "value": "@fields.sac_riz",
      "action_list": "changed | set_field: sac_riz : this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;",
      "style_list": "margin: 10px;"
    },
    {
      "name": "valid_sac_riz",
      "value": "@calc((/^\\d+(\\.\\d+)?$/.test(@local.sac_riz) && Number(@local.sac_riz) < @fields.besoin_cereale_exploitation) || !@local.sac_riz)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.sac_riz && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.erreur_sacs",
      "condition": "!@local.valid_sac_riz",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "sac_cereales",
      "value": "@calc(Number(@field.sac_mais || 0) + Number(@field.sac_mil || 0) + Number(@field.sac_sorgho || 0) + Number(@fields.sac_riz || 0))"
    },
    {
      "name": "sac_cereales_diff",
      "value": "@calc(Math.abs(@local.sac_cereales - @fields.besoin_cereale_exploitation))"
    },
    {
      "type": "text",
      "value": "@global.message_cumul_sac"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.sac_cereales == @fields.besoin_cereale_exploitation",
      "style_list": "background: #e8f5e9; text-align: center; border-radius: 10px;"
    },
    {
      "type": "text",
      "value": "@global.msg_cumul_ok",
      "style_list": "color: #4caf50; font-weight: bold; font-size: 16px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "msg_sup",
      "parameter_list": "style: column",
      "condition": "@local.sac_cereales > @field.besoin_cereale_exploitation",
      "style_list": "background: #ffebee; text-align: center; border-radius: 10px;"
    },
    {
      "type": "text",
      "value": "@global.msg_cumul_sup",
      "style_list": "color: #c62828; font-weight: bold; font-size: 16px;"
    },
    {
      "type": "text",
      "value": "@global.msg_cumul_sup_hint",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@local.sac_cereales < @field.besoin_cereale_exploitation && @local.sac_cereales > 0",
      "style_list": "background: #fff3e0;border-radius: 10px; text-align: center;"
    },
    {
      "type": "text",
      "value": "@global.msg_cumul_inf",
      "style_list": "color: #ef6c00; font-weight: bold; font-size: 16px;"
    },
    {
      "type": "text",
      "value": "@global.msg_cumul_inf_hint",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@local.sac_cereales == @field.besoin_cereale_exploitation"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page3_button_back",
      "action_list": "click | set_field: attempt_submit: false;\nclick | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_continue_attempt_submit",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;\n",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page3_button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "\ndisabled: !@local.completed_enabled\n",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
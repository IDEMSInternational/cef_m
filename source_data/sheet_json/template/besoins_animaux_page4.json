{
  "flow_type": "template",
  "flow_name": "besoins_animaux_page4",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.nbre_tete_regime"
    },
    {
      "type": "text",
      "value": "@global.nbre_animaux"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_data_items",
      "value": "@data.categorie_animaux",
      "parameter_list": "filter: @item.name == @fields.current_cat_animaux"
    },
    {
      "type": "text",
      "value": "@item.text"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "subtitle",
      "value": "@global.note_nbre_animaux"
    },
    {
      "type": "text",
      "value": "@global.hint_note_nbre_animaux",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "nb_animaux",
      "value": "@fields.nb_animaux",
      "action_list": "changed | set_field: nb_animaux : this.value;",
      "parameter_list": "number_input: true; placeholder: @global.texte_placeholder;",
      "exclude_from_translation_1": true
    },
    {
      "name": "valid_nb_animaux",
      "value": "@calc((/^\\d+$/.test(@fields.nb_animaux) && @fields.nb_animaux>0 ) || @fields.nb_animaux == '' || !@fields.nb_animaux )"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.nb_animaux && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_nb_animaux",
      "style_list": "@global.reponse_style",
      "exclude_from_translation_1": true
    },
    {
      "type": "text",
      "value": "@global.regime_alimentaire"
    },
    {
      "type": "text",
      "value": "@global.note_regime_alimentaire"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_radio_list",
      "name": "type_regime",
      "value": "@fields.type_regime",
      "action_list": "changed | set_field: type_regime: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.regime_animaux"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.type_regime && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.nb_animaux && @fields.type_regime"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page4_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page4_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: type_regime_@fields.current_cat_animaux : @local.type_regime;\nclick | set_field: nb_animaux_@fields.current_cat_animaux : @fields.nb_animaux;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "enrolment_page9",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.asso_producteur"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.un_cereale_id_note"
    },
    {
      "type": "audio",
      "name": "audio_9_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/union_cereales_fr.mp2;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/op_cereales.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.un_cereale_id",
      "action_list": "changed | set_field : un_cereale_id: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.village_UN_cereale",
      "parameter_list": "filter: @item.village == @fields.village_id"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.un_cereale_id && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.base_coop_cereale_id_note"
    },
    {
      "type": "audio",
      "name": "audio_9_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Enrolement/union_cereales_fr.mp2;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/op_cereales.jpg",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "begin_radio_list",
      "value": "@fields.base_coop_cereale_id",
      "action_list": "changed | set_field : base_coop_cereale_id: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.village_base_COOP",
      "parameter_list": "filter: @item.village == @fields.village_id"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.base_coop_cereale_id && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.un_cereale_id && @fields.base_coop_cereale_id "
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
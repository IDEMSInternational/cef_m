{
  "flow_type": "template",
  "flow_name": "superficie_champs_page8",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "DATE ET QUANTITÉ DE SEMIS"
    },
    {
      "name": "attempt_submit_p9",
      "value": "@fields.attempt_submit_p9"
    },
    {
      "name": "valid_qte",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@fields.quantite_semence) && Number(@fields.quantite_semence) >= 0)"
    },
    {
      "name": "valid_p9",
      "value": "@calc(!!@fields.date_semence && !!@fields.quantite_semence && @local.valid_qte)"
    },
    {
      "type": "html",
      "value": "<h1 style=\"color: #1e3656; margin: 0; font-size: 15px; text-transform: uppercase;\">Semis de @fields.cult_princip dans la parcelle N⁰@fields.num_parcelle</h1>"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "value": "<label font-weight: bold;\"><span style=\"color: red;\">*</span> Date de semis de <b>@fields.cult_princip</b> </label>"
    },
    {
      "type": "audio",
      "name": "audio_9_1",
      "parameter_list": "\nvariant: button_only; src: audio/Superficie/date_semence_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_data_items",
      "value": "@data.cult_princip",
      "parameter_list": "filter: @item.name == @fields.cult_princip"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width: 40%; object-fit: contain;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "date_time_picker",
      "name": "date_semence",
      "value": "@fields.date_semence",
      "action_list": "changed | set_field: date_semence: this.value;",
      "parameter_list": "type: date"
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<span style=\"color: red; font-size: 13px;\">La date est obligatoire ! </span>",
      "condition": "@fields.attempt_submit_p9 && !@fields.date_semence"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> Quantité de semence de @fields.cult_princip (en kg) </label"
    },
    {
      "type": "audio",
      "name": "audio_9_2",
      "parameter_list": "variant: button_only; src: audio/Superficie/q_semence_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/kg.jpg",
      "style_list": "width:30%;object-fit:contain;"
    },
    {
      "type": "html",
      "value": "<p style=\"color: #555; font-size: 14px;\">@global.semence_kg</p>"
    },
    {
      "type": "text_box",
      "name": "quantite_semence",
      "value": "@fields.quantite_semence",
      "action_list": "changed | set_field: quantite_semence : this.value;",
      "parameter_list": "number_input: true\nplaceholder: Entrez la quantite en kg;",
      "condition": "!!@fields.quantite_semence",
      "exclude_from_translation": true
    },
    {
      "type": "text_box",
      "name": "quantite_semence",
      "action_list": "changed | set_field: quantite_semence : this.value;",
      "parameter_list": "number_input: true;\nplaceholder: Entrez la quantite en kg;",
      "condition": "!@field.quantite_semence",
      "exclude_from_translation": true
    },
    {
      "type": "html",
      "name": "html_text",
      "value": "<span style=\"color: red; font-size: 13px;\">La quantité est obligatoire !</span>",
      "condition": "@fields.attempt_submit_p9 && !@fields.quantite_semence"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 13px;\">Veuillez saisir un nombre valide (>= 0) !</span>",
      "condition": "!!@fields.quantite_semence && !@local.valid_qte"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page9_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page9_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('date_semis_parcelle_N' + @fields.num_parcelle) : @fields.date_semence;\nclick | set_field: @calc('quantite_semence_parcelle_N' + @fields.num_parcelle) : @fields.quantite_semence;\nclick | set_field: attempt_submit_p9: false;\n click | emit: completed;",
      "parameter_list": "disabled: !@local.valid_p9",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "cultures_page4",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_data_items",
      "value": "@data.planif_cultures_primaires",
      "parameter_list": "filter: @item.name == @fields.culture_label"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "**@item.text**"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "title",
      "value": "@global.prev_engrais_organiq"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.cout_fumure_organiq"
    },
    {
      "type": "audio",
      "name": "audio_4_1",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/cout_semence_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.cout_fumure_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "cout_prevu_fumure",
      "value": "@fields.cout_prevu_fumure",
      "action_list": "changed | set_field : cout_prevu_fumure: this.value;",
      "parameter_list": "number_input: true;\nplaceholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_cout_prevu_fumure",
      "value": "@calc((/^\\d+$/.test(@fields.cout_prevu_fumure) && @fields.cout_prevu_fumure >=0 ) || @fields.cout_prevu_fumure == '' || !!@fields.cout_prevu_fumure )"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@local.valid_cout_prevu_fumure",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.cout_transport_fumure"
    },
    {
      "type": "audio",
      "name": "audio_4_2",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/cout_semence_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.cout_fumure_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "cout_prevu_transport_fumure",
      "value": "@fields.cout_prevu_transport_fumure",
      "action_list": "changed | set_field : cout_prevu_transport_fumure: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: @global.texte_placeholder;"
    },
    {
      "name": "valid_cout_prevu_transport_fumure",
      "value": "@calc((/^\\d+$/.test(@fields.cout_prevu_transport_fumure) && @fields.cout_prevu_transport_fumure >=0 ) || @fields.cout_prevu_transport_fumure == '' || !!@fields.cout_prevu_transport_fumure )"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@local.valid_cout_prevu_transport_fumure",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_cout_prevu_transport_fumure && @local.valid_cout_prevu_fumure"
    },
    {
      "name": "cout_total_fumure",
      "value": "@calc(Number(@fields.cout_prevu_fumure) + Number(@fields.cout_prevu_transport_fumure))"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_4_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_4_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_4_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: cout_total_fumure : @local.cout_total_fumure;\nclick | set_field: cout_prevu_fumure_@fields.culture_label : @fields.cout_prevu_fumure;\nclick | set_field: cout_total_fumure_@fields.culture_label : @local.cout_total_fumure;\nclick | set_field: cout_prevu_transport_fumure_@fields.culture_label : @fields.cout_prevu_transport_fumure;\nclick | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
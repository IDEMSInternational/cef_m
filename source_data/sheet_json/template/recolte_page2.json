{
  "flow_type": "template",
  "flow_name": "recolte_page2",
  "status": "released",
  "rows": [
    {
      "name": "v_current_human",
      "value": "@calc(Number(@field.current_culture_index) + 1)"
    },
    {
      "name": "v_prod_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.superficie_recolte_prestation))"
    },
    {
      "name": "v_prod_err",
      "value": "@calc(!@local.v_prod_fmt || Number(@field.superficie_recolte_prestation) < 0)"
    },
    {
      "name": "v_batt_fmt",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@field.cout_total_prestation_recolte_nonzero))"
    },
    {
      "name": "v_batt_err",
      "value": "@calc(!@local.v_batt_fmt || Number(@field.cout_total_prestation_recolte_nonzero) < 0)"
    },
    {
      "type": "begin_display_group",
      "name": "header",
      "style_list": "background: #00adcc; padding: 15px; border-radius: 0 0 15px 15px; margin-bottom: 20px;"
    },
    {
      "type": "text",
      "value": "CULTURE @local.v_current_human / @field.total_cultures_selected",
      "style_list": "color: white; font-weight: bold; font-size: 14px; text-transform: uppercase;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "1.RECOLTE"
    },
    {
      "type": "begin_display_group",
      "style_list": "width: 100%; display: flex; flex-direction: column; align-items: center; border: 1px solid #FFCC80; border-radius: 12px; background: white; margin-bottom: 10px; overflow: hidden;"
    },
    {
      "type": "image",
      "value": "@calc(['mais','mil','sorgho','coton','arachide','fourrage','fonio','riz','sésame','wouandzou','patate','bissap'].includes((@field.active_culture_name || '').toLowerCase().trim()) ? 'images/' + @field.active_culture_name + '.jpg' : 'images/autre.jpeg')",
      "style_list": "width: 60%; object-fit: contain;"
    },
    {
      "type": "text",
      "value": "Culture : @field.active_culture_name",
      "style_list": "font-weight: bold; font-size: 18px; color: #e3a730; margin-top: 10px; text-align: center;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "prod",
      "style_list": "display: block; width: 100%;"
    },
    {
      "type": "audio",
      "name": "aud_prod",
      "parameter_list": "variant: button_only;\nsrc: audio/recolte/sup_recolt_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.sup_recolte",
      "style_list": "font-weight: bold; font-size: 16px; color: #333; margin-bottom: 5px;"
    },
    {
      "type": "image",
      "value": "images/superf_unit.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "superficie_recolte_prestation",
      "value": "@field.superficie_recolte_prestation",
      "action_list": "changed | set_field: superficie_recolte_prestation : this.value;",
      "parameter_list": "number_input: true;"
    },
    {
      "type": "text",
      "value": "@global.error_positive_value",
      "condition": "@local.v_prod_err",
      "style_list": "font-size: 12px; color: red;"
    },
    {
      "type": "begin_display_group",
      "name": "cout_total_prestation_recolte_nonzero",
      "condition": "@calc(Number(@field.superficie_recolte_prestation || 0) > 0)",
      "style_list": "display: block; width: 100%;"
    },
    {
      "type": "audio",
      "name": "aud_batt",
      "parameter_list": "variant: button_only;\nsrc: audio/recolte/cout_recolt_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.cout_prest_recolte",
      "style_list": "font-weight: bold; font-size: 14px; color: #333;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box",
      "name": "cout_total_prestation_recolte_nonzero",
      "value": "@field.cout_total_prestation_recolte_nonzero",
      "action_list": "changed | set_field: cout_total_prestation_recolte_nonzero: this.value;",
      "parameter_list": "number_input: true;placeholder: Montant en Dram;"
    },
    {
      "type": "text",
      "value": "La valeur doit être positive",
      "condition": "@local.v_batt_err",
      "style_list": "font-size: 12px; color: red;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "cout_total_prestation_recolte_zero",
      "condition": "@calc(Number(@field.superficie_recolte_prestation || 0) === 0)",
      "style_list": "display: block; width: 100%;"
    },
    {
      "type": "audio",
      "name": "prestation_recolte_zero",
      "parameter_list": "variant: button_only;\nsrc: audio/recolte/cout_recolt_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "exclude_from_translation": true,
      "style_list": "float: right;"
    },
    {
      "type": "text",
      "value": "@global.cout_prest_recolte",
      "style_list": "font-weight: bold; font-size: 14px; color: #333;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "font-size: 14px; color: gray;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width: 100px; height: 100px;"
    },
    {
      "type": "text_box",
      "value": 0,
      "parameter_list": "disabled: true;"
    },
    {
      "type": "text",
      "name": "cout_total_battage_zero",
      "value": "Coût bloqué à 0 car aucune récolte obtenue",
      "style_list": "font-size: 12px; color: #999;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "v_val_nonzero",
      "value": "@calc(Number(@field.cout_total_prestation_recolte_nonzero) || 0)"
    },
    {
      "name": "v_final_rec",
      "value": "@calc(@field.superficie_recolte_prestation == 0 ? 0 : @local.v_val_nonzero)"
    },
    {
      "name": "v_page5_valid",
      "value": "@calc(@local.v_prod_fmt && Number(@field.superficie_recolte_prestation || 0) >= 0 && (Number(@field.superficie_recolte_prestation || 0) === 0 || (@local.v_batt_fmt && Number(@field.cout_total_prestation_recolte_nonzero || 0) >= 0)))"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "button_completed",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: final_cout_recolte : @local.v_final_rec;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.v_page5_valid",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
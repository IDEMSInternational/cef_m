{
  "flow_type": "template",
  "flow_name": "depenses_page2",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.petite_depenses"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "text",
      "name": "depenses_condiments",
      "value": "@global.depenses_condiments"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "name": "note_frais_condiment_info",
      "value": "@global.note_frais_condiment_info"
    },
    {
      "type": "audio",
      "name": "audio_2_1",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/approche_condi_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/condiments.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "note_frais_condiment_info_hint",
      "value": "@global.note_frais_condiment_info_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.frais_condiment_jour_label"
    },
    {
      "type": "audio",
      "name": "audio_2_2",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/condiment_jour_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "name": "hint_price",
      "value": "@global.hint_price",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "frais_condiment_jour",
      "value": "@fields.frais_condiment_jour",
      "action_list": "changed | set_field : frais_condiment_jour: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_frais_condiment_jour",
      "value": "@calc(!!@fields.frais_condiment_jour && @fields.frais_condiment_jour != \"\" && @fields.frais_condiment_jour >= 0)"
    },
    {
      "type": "text",
      "name": "error_frais_condiment_jour",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.frais_condiment_jour",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "frais_condiment_annuel",
      "value": "@calc(Math.round(@fields.frais_condiment_jour * 365))"
    },
    {
      "name": "note_frais_condiment_cfa",
      "value": "@calc(Number(@local.frais_condiment_annuel || 0) * 5)"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.montant_prev_condiment"
    },
    {
      "type": "audio",
      "name": "audio_2_3",
      "parameter_list": "variant: button_only;\nsrc: audio/depensesRevenus/condiment_annuel_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@local.valid_frais_condiment_jour",
      "style_list": "background: #FFF3E0; border-radius: 15px; text-align: center; border: 2px solid #E65100;"
    },
    {
      "type": "text",
      "value": "@global.note_frais_condiment",
      "style_list": "font-size: 16px; color: #6D4C41;"
    },
    {
      "type": "text",
      "value": "@local.frais_condiment_annuel drm",
      "style_list": "color: #E65100; margin: 10px 0;"
    },
    {
      "type": "text",
      "value": "@local.note_frais_condiment_cfa FCFA",
      "style_list": "color: #2E7D32; font-weight: bold; font-size: 20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_frais_condiment_jour"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_2_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_2_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_2_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: false;\nclick | set_field: frais_condiment_annuel: @local.frais_condiment_annuel;\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "cultures_page10",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_data_items",
      "value": "@data.planif_cultures_primaires",
      "parameter_list": "filter: @item.name == @fields.culture_label"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "image",
      "value": "@item.image",
      "style_list": "width:150px; height:150px; "
    },
    {
      "type": "text",
      "value": "**@item.text**"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "title",
      "value": "@global.prod_prev"
    },
    {
      "type": "text",
      "value": "@global.prod_prev_label"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.cout_prest_recolte"
    },
    {
      "type": "audio",
      "name": "audio_10_1",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/cout_recolt_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.cout_prev_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "cout_prevu_total_prestation_recolte",
      "value": "@fields.cout_prevu_total_prestation_recolte",
      "action_list": "changed | set_field : cout_prevu_total_prestation_recolte: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: @global.texte_placeholder;"
    },
    {
      "name": "valid_cout_prevu_total_prestation_recolte",
      "value": "@calc(!!@fields.cout_prevu_total_prestation_recolte && @fields.cout_prevu_total_prestation_recolte != ' ' && @fields.cout_prevu_total_prestation_recolte >= 0)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@local.valid_cout_prevu_total_prestation_recolte",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.cout_battage"
    },
    {
      "type": "audio",
      "name": "audio_10_2",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/cout_battage_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.cout_prev_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "cout_prevu_total_battage",
      "value": "@fields.cout_prevu_total_battage",
      "action_list": "changed | set_field : cout_prevu_total_battage: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: @global.texte_placeholder;"
    },
    {
      "name": "valid_cout_prevu_total_battage",
      "value": "@calc(!!@fields.cout_prevu_total_battage && @fields.cout_prevu_total_battage != ' ' && @fields.cout_prevu_total_battage >= 0)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@local.valid_cout_prevu_total_battage",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.prod_superf_culture"
    },
    {
      "type": "audio",
      "name": "audio_10_3",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/production_graine_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/kg.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "production_prevue",
      "value": "@fields.production_prevue",
      "action_list": "changed | set_field : production_prevue: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: @global.texte_placeholder;"
    },
    {
      "name": "valid_production_prevue",
      "value": "@calc(!!@fields.production_prevue && @fields.production_prevue != ' ' && @fields.production_prevue >= 0)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@local.valid_production_prevue",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_cout_prevu_total_prestation_recolte && @local.valid_cout_prevu_total_battage"
    },
    {
      "name": "cout_prevu_recolte_battage",
      "value": "@calc(Number(@fields.cout_prevu_total_prestation_recolte || 0) + Number(@fields.cout_prevu_total_battage || 0))"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_10_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_10_btn_attempt_submit",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_10_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: cout_prevu_recolte_battage : @local.cout_prevu_recolte_battage;\nclick | set_field: cout_prevu_recolte_battage_@fields.culture_label : @local.cout_prevu_recolte_battage;\nclick | set_field: production_prevue_@fields.culture_label : @fields.production_prevue;\n\nclick | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
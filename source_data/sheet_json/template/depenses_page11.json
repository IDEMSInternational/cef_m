{
  "flow_type": "template",
  "flow_name": "depenses_page11",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.autre_investissement"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "subtitle ",
      "value": "@global.autre_invest_yesno_title"
    },
    {
      "type": "text",
      "value": "@global.autre_invest_yesno_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "begin_radio_list",
      "name": "autre_invest",
      "value": "@fields.autre_invest_yes_no",
      "action_list": "changed | set_field : autre_invest_yes_no: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "name": "valid_autre_invest",
      "value": "@local.autre_invest != null && @local.autre_invest != undefined && @local.autre_invest != ' ' "
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_autre_invest",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group",
      "condition": "@local.autre_invest == 'oui'",
      "style_list": "width: 100%; display: block;"
    },
    {
      "type": "subtitle",
      "value": "@global.nom_autre_invest_label",
      "style_list": "font-size:20px;"
    },
    {
      "type": "image",
      "value": "images/autre_depense.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "nom_autre_invest",
      "value": "@fields.nom_autre_invest",
      "action_list": "changed | set_field : nom_autre_invest: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_nom_autre_invest",
      "value": "@calc(!!@fields.nom_autre_invest && @fields.nom_autre_invest != \"\")"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@local.autre_invest == \"oui\" && @fields.attempt_submit && !@local.valid_nom_autre_invest",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px; margin-top:10px;"
    },
    {
      "type": "subtitle",
      "name": "montant_autre_invest_label",
      "value": "@global.montant_autre_invest_label",
      "style_list": "font-size:20px; margin-top:20px;"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "montant_autre_invest",
      "value": "@fields.montant_autre_invest",
      "action_list": "changed | set_field : montant_autre_invest: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_montant_autre_invest",
      "value": "@calc(!!@fields.montant_autre_invest && @fields.montant_autre_invest != \"\" && @fields.montant_autre_invest >= 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@local.autre_invest == \"oui\" && @fields.attempt_submit && !@local.valid_montant_autre_invest",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px; margin-top:10px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(@local.autre_invest == \"non\" || (@local.autre_invest == \"oui\" && @local.valid_nom_autre_invest && @local.valid_montant_autre_invest))"
    },
    {
      "type": "begin_display_group",
      "name": "dg_footer",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_11_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_11_btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_11_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
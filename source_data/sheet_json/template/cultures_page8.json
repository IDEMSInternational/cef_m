      "value": "@calc(!!@fields.cout_prevu_autre_engrais && @fields.cout_prevu_autre_engrais != ' ' && @fields.cout_prevu_autre_engrais >= 0)"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@local.valid_cout_prevu_autre_engrais",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "npk_coton_14_18_18_prevue_achat",
      "value": "@calc(Number(@fields.quantite_prevue_npk_coton_14_18_18 || 0))"
    },
    {
      "name": "npk_cereale_15_15_15_prevue_achat",
      "value": "@calc(Number(@fields.quantite_prevue_npk_cereale_15_15_15 || 0))"
    },
    {
      "name": "npk_cereale_17_17_17_prevue_achat",
      "value": "@calc(Number(@fields.quantite_prevue_npk_cereale_17_17_17 || 0))"
    },
    {
      "name": "dap_prevue_achat",
      "value": "@calc(Number(@fields.quantite_prevue_dap || 0))"
    },
    {
      "name": "uree_prevu_achat",
      "value": "@calc(Number(@fields.quantite_prevue_uree || 0))"
    },
    {
      "name": "autre_engrais",
      "value": "@calc(Number(@fields.quantite_prevue_autre_engrais || 0))"
    },
    {
      "name": "cout_prevu_engrais",
      "value": "@calc(Number(@fields.cout_prevu_npk_coton_14_18_18 || 0) + Number(@fields.cout_prevu_npk_cereale_15_15_15 || 0) + Number(@fields.cout_prevu_npk_cereale_17_17_17 || 0) + Number(@fields.cout_prevu_npk_dap || 0) + Number(@fields.cout_prevu_uree || 0) + Number(@fields.cout_prevu_autre_engrais || 0))"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.aucun_engrais "
    },
    {
      "type": "image",
      "value": "images/sac.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "Engrais: @local.cout_prevu_engrais sacs",
      "style_list": "color: green; font-size: 16px; background: #a5df93; padding: 5px;"
    },
    {
      "type": "audio",
      "name": "audio_8_13",
      "parameter_list": "variant: button_only;\nsrc: audio/semis/q_npk_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@calc((!!@fields.quantite_prevue_npk_coton_14_18_18 && @local.valid_cout_prevu_npk_coton_14_18_18) || (!!@fields.quantite_prevue_npk_cereale_15_15_15 && @local.valid_cout_prevu_npk_cereale_15_15_15) || (@fields.quantite_prevue_npk_cereale_17_17_17 && @local.valid_cout_prevu_npk_cereale_17_17_17) || (@fields.quantite_prevue_dap && @local.valid_cout_prevu_npk_dap) || (@fields.quantite_prevue_uree && @local.valid_cout_prevu_uree) || (@fields.quantite_prevue_autre_engrais && @local.valid_cout_prevu_autre_engrais))"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_8_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_8_btn_attempt_submit",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_8_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: cout_prevu_engrais : @local.cout_prevu_engrais;\nclick | set_field: cout_prevu_engrais_@fields.culture_label : @local.cout_prevu_engrais;\nclick | set_field: npk_coton_14_18_18_prevue_achat_@fields.culture_label : @local.npk_coton_14_18_18_prevue_achat;\nclick | set_field: npk_cereale_15_15_15_prevue_achat_@fields.culture_label : @local.npk_cereale_15_15_15_prevue_achat;\nclick | set_field: npk_cereale_17_17_17_prevue_achat_@fields.culture_label : @local.npk_cereale_17_17_17_prevue_achat;\nclick | set_field: dap_prevue_achat_@fields.culture_label : @local.dap_prevue_achat;\nclick | set_field: uree_prevu_achat_@fields.culture_label : @local.uree_prevu_achat;\nclick | set_field: autre_engrais_@fields.culture_label : @local.autre_engrais;\n\nclick | set_field: attempt_submit: false;\nclick | emit: completed\n",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    },
    {
      "parameter_list": "\n\n"
    }
  ]
}
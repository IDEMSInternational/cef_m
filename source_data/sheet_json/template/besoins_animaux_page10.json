{
  "flow_type": "template",
  "flow_name": "besoins_animaux_page10",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.depense_tourteau_title"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "subtitle",
      "value": "@global.note_qtite_tourteau_achete"
    },
    {
      "type": "image",
      "value": "images/tourteau.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "begin_display_group",
      "style_list": "background-color: #f0f4f8; border-left-style: solid; border-left-color: #0056b3; border-radius: 5px;"
    },
    {
      "type": "text",
      "value": "@global.note_quantite_sac_tourteau"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.note_prix_sac_tourteau"
    },
    {
      "type": "text",
      "value": "@global.drm_cfa_hint"
    },
    {
      "type": "image",
      "value": "images/cfa.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "prix_sac_tourteau",
      "value": "@fields.prix_sac_tourteau",
      "action_list": "changed | set_field: prix_sac_tourteau : this.value;",
      "parameter_list": "number_input: true; placeholder: @global.texte_placeholder;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.prix_sac_tourteau && @fields.attempt_submit",
      "style_list": "@global.hint_style"
    },
    {
      "name": "valid_prix_sac_tourteau",
      "value": "@calc((/^\\d+$/.test(@fields.prix_sac_tourteau) && @fields.prix_sac_tourteau > 0 ) || @fields.prix_sac_tourteau == '' || !@fields.prix_sac_tourteau)"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_prix_sac_tourteau",
      "exclude_from_translation": true,
      "style_list": "color: #FF0000;\nfont-size: 14px"
    },
    {
      "type": "subtitle",
      "value": "@global.note_montant_tourteau",
      "condition": "@fields.prix_sac_tourteau "
    },
    {
      "type": "text",
      "value": "@global.drm_cfa_hint",
      "condition": "@fields.prix_sac_tourteau "
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "condition": "@fields.prix_sac_tourteau ",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "set_field",
      "name": "cal_depense_tourteau",
      "value": "@calc((Number(@fields.quantite_tourteau || 0) * Number(@fields.prix_sac_tourteau || 0)).toFixed(1))",
      "condition": "@fields.prix_sac_tourteau "
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.prix_sac_tourteau ",
      "style_list": "background-color: #f0f4f8; border-left-style: solid; border-left-color: #0056b3; border-radius: 5px;"
    },
    {
      "type": "text",
      "value": "@global.montant_tourteau"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.hint_montant_tourteau",
      "condition": "@fields.prix_sac_tourteau ",
      "style_list": "@global.hint_style"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.prix_sac_tourteau"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page12_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page12_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
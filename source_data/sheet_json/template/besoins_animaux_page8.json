{
  "flow_type": "template",
  "flow_name": "besoins_animaux_page8",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.repartition_besoin_prevision"
    },
    {
      "type": "text",
      "value": "@global.note_total_concentre"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "image",
      "value": "images/Residus.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "subtitle",
      "value": "@global.hint_total_concentre"
    },
    {
      "type": "text",
      "value": "@global.note_qtite_son"
    },
    {
      "type": "image",
      "value": "images/son_cereal.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "quantite_son",
      "value": "@fields.quantite_son",
      "action_list": "changed | set_field: quantite_son : this.value;",
      "parameter_list": "number_input: true; placeholder: @global.texte_placeholder;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.quantite_son && @fields.attempt_submit",
      "style_list": "@global.reponse_style"
    },
    {
      "name": "valid_quantite_son",
      "value": "@calc((/^\\d+$/.test(@fields.quantite_son) && @fields.quantite_son<= @fields.total_concentre ) || @fields.quantite_son == '' || !@fields.quantite_son )"
    },
    {
      "type": "text",
      "value": "@global.validite_nombre",
      "condition": "!@local.valid_quantite_son",
      "exclude_from_translation": true,
      "style_list": "@global.reponse_style"
    },
    {
      "type": "text",
      "value": "@global.note_qtite_tourteau",
      "condition": "@fields.quantite_son > 0 "
    },
    {
      "type": "text",
      "value": "@global.hint_qtite_tourteau",
      "condition": "@fields.quantite_son > 0 "
    },
    {
      "type": "image",
      "value": "images/tourteau.jpg",
      "condition": "@fields.quantite_son > 0 ",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "set_field",
      "name": "quantite_tourteau",
      "value": "@calc(Number(@fields.total_concentre) - Number(@fields.quantite_son))",
      "condition": "@fields.quantite_son "
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.quantite_son",
      "style_list": "background-color: #f0f4f8; border-left-style: solid; border-left-color: #0056b3; border-radius: 5px;"
    },
    {
      "type": "text",
      "value": "@global.note_tourteau_label"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "completed_enabled",
      "value": "@fields.quantite_son"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page10_button_back",
      "action_list": "click | emit: uncompleted;",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page10_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
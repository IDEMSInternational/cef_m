{
  "flow_type": "template",
  "flow_name": "section_fumure_page7",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.production_annuel_fumure"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.quantite_compost_produite_note"
    },
    {
      "type": "audio",
      "name": "audio_7_1",
      "parameter_list": "variant: button_only;\nsrc: audio/fumureOrganique/compost_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/unit_fumure.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.fumure_produite_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "quantite_compost",
      "value": "@fields.quantite_compost",
      "action_list": "changed | set_field: quantite_compost: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_quantite_compost",
      "value": "@calc(!!@fields.quantite_compost && @fields.quantite_compost != \"\" && @fields.quantite_compost >= 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_quantite_compost",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.quantite_fumier_produite_note"
    },
    {
      "type": "audio",
      "name": "audio_7_2",
      "parameter_list": "variant: button_only;\nsrc: audio/fumureOrganique/fumier_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/unit_fumure.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.fumure_produite_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "quantite_fumier",
      "value": "@fields.quantite_fumier",
      "action_list": "changed | set_field: quantite_fumier: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_quantite_fumier",
      "value": "@calc(!!@fields.quantite_fumier && @fields.quantite_fumier != \"\" && @fields.quantite_fumier >= 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_quantite_fumier",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.quantite_ordures_menageres_produite_note"
    },
    {
      "type": "audio",
      "name": "audio_7_3",
      "parameter_list": "variant: button_only;\nsrc: audio/fumureOrganique/ordures_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/unit_fumure.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.fumure_produite_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "quantite_ordures_menageres",
      "value": "@fields.quantite_ordures_menageres",
      "action_list": "changed | set_field: quantite_ordures_menageres: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_quantite_ordures_menageres",
      "value": "@calc(!!@fields.quantite_ordures_menageres && @fields.quantite_ordures_menageres != \"\" && @fields.quantite_ordures_menageres >= 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_quantite_ordures_menageres",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.fumure_organique_autre_note"
    },
    {
      "type": "audio",
      "name": "audio_7_4",
      "parameter_list": "variant: button_only;\nsrc: audio/fumureOrganique/on_autre_fumure_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_radio_list",
      "name": "fumure_organique_autre",
      "value": "@fields.fumure_organique_autre",
      "action_list": "changed | set_field : fumure_organique_autre: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "!@fields.fumure_organique_autre && @fields.attempt_submit",
      "style_list": "@global.hint_style"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column;",
      "condition": "@fields.fumure_organique_autre =='oui' "
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.nom_autre_fumure_note"
    },
    {
      "type": "audio",
      "name": "audio_7_5",
      "parameter_list": "variant: button_only;\nsrc: audio/fumureOrganique/nom_autre_fumure_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/autre_fumure.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text_box",
      "name": "nom_fumure_organique_autre",
      "value": "@fields.nom_fumure_organique_autre",
      "action_list": "changed | set_field: nom_fumure_organique_autre: this.value;",
      "parameter_list": "placeholder:@global.texte_placeholder;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.quantite_fumure_organique_autre_note"
    },
    {
      "type": "audio",
      "name": "audio_7_6",
      "parameter_list": "variant: button_only;\nsrc: audio/fumureOrganique/autre_fumure_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/unit_fumure.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.fumure_produite_hint",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "text_box",
      "name": "quantite_fumure_organique_autre",
      "value": "@fields.quantite_fumure_organique_autre",
      "action_list": "changed | set_field: quantite_fumure_organique_autre: this.value;",
      "parameter_list": "number_input: true; placeholder:@global.texte_placeholder;"
    },
    {
      "name": "valid_quantite_fumure_organique_autre",
      "value": "@calc(!!@fields.quantite_fumure_organique_autre && @fields.quantite_fumure_organique_autre != \"\" && @fields.quantite_fumure_organique_autre >= 0)"
    },
    {
      "type": "text",
      "value": "@global.error_required_answer",
      "condition": "@fields.attempt_submit && !@local.valid_quantite_fumure_organique_autre",
      "style_list": "color: red; font-size: 16px; background: #fff5f5; padding: 5px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "quantite_total_fumure_organique",
      "value": "@calc(Number(@fields.quantite_compost) + Number(@fields.quantite_fumier) + Number(@fields.quantite_ordures_menageres) + Number(@fields.quantite_fumure_organique_autre || 0))"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_quantite_compost && @local.valid_quantite_fumier && @local.valid_quantite_ordures_menageres"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_7_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "btn_attempt_submit",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_7_button_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: quantite_total_fumure_organique: @local.quantite_total_fumure_organique;\n\nclick | set_field: attempt_submit: false;\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
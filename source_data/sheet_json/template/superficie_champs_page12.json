{
  "flow_type": "template",
  "flow_name": "superficie_champs_page12",
  "status": "released",
  "rows": [
    {
      "name": "valid_npk_coton",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@fields.quantite_npk_coton) && Number(@fields.quantite_npk_coton) >= 0)"
    },
    {
      "name": "valid_npk_cereale",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@fields.quantite_npk_cereale) && Number(@fields.quantite_npk_cereale) >= 0)"
    },
    {
      "name": "valid_uree",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@fields.quantite_uree) && Number(@fields.quantite_uree) >= 0)"
    },
    {
      "name": "valid_dap",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@fields.quantite_dap) && Number(@fields.quantite_dap) >= 0)"
    },
    {
      "name": "valid_autre_engrais",
      "value": "@calc(!@fields.autre_engrais_mineral || @fields.autre_engrais_mineral === 'non' || (@fields.autre_engrais_mineral === 'oui' && !!@fields.nom_autre_engrais && @fields.nom_autre_engrais.trim() !== '' && /^\\d+(\\.\\d+)?$/.test(@fields.quantite_autre_engrais) && Number(@fields.quantite_autre_engrais) >= 0))"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(!!@fields.on_fertilisant_info && (@fields.on_fertilisant_info === 'non' || (@fields.on_fertilisant_info === 'oui' && (@fields.culture === 'coton' ? @local.valid_npk_coton : @local.valid_npk_cereale) && @local.valid_uree && (@fields.culture !== 'riz' || @local.valid_dap) && @local.valid_autre_engrais)))"
    },
    {
      "type": "title",
      "value": "**Quantité d'engrais minéraux dans la parcelle N⁰@fields.num_parcelle de @fields.nom_champ**"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> L'information sur les engrais minéraux est-elle disponible ?</label>"
    },
    {
      "type": "audio",
      "name": "audio_13_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/on_info_engrais_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_radio_list",
      "name": "on_fertilisant_info",
      "value": "@fields.on_fertilisant_info",
      "action_list": "changed | set_field: on_fertilisant_info: this.value;",
      "style_list": "display: flex; align-items: center; grid_gap: 15px; margin-top: 10px;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 17px;\">La sélection est obligatoire !</span>",
      "condition": "@fields.attempt_submit_p13 && !@fields.on_fertilisant_info"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_fertilisant_info == 'non'",
      "style_list": "margin: 15px 0; padding: 12px; background: #fff3cd;"
    },
    {
      "type": "html",
      "value": "<p style=\"margin: 0; color: #856404; font-size: 17px; line-height: 1.4; font-weight: 500;\">VEUILLEZ CONTINUER. Cependant, vous devez revenir renseigner les quantités des engrais minéraux dès que l'information sera disponible.</p>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.culture == 'coton'"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;\n"
    },
    {
      "type": "html",
      "value": "<span style=\"font-size: 17px; color: #1e3656; font-weight: bold;\">Complexe Coton 14-18-18 (sacs de 50kg)</span>"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/qte_npk_coton_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sac.jpg",
      "style_list": "width: 50%; object-fit: contain;\n\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_npk_coton",
      "value": "@fields.quantite_npk_coton",
      "action_list": "changed | set_field: quantite_npk_coton: this.value;",
      "parameter_list": "placeholder: Mettez 0 si aucun apport;",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.culture == 'coton'"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 17px;\">Veuillez entrer une quantité valide (nombre positif ou 0) !</span>",
      "condition": "@fields.attempt_submit_p13 && !@local.valid_npk_coton"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.culture != 'coton'",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span><span style=\"font-size: 17px; color: #1e3656; font-weight: bold;\">Complexe Céréale NPK (sacs de 50kg)</span>"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/qte_npk_15_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sac.jpg",
      "style_list": "width: 50%; object-fit: contain;\n\n\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_npk_cereale",
      "value": "@fields.quantite_npk_cereale",
      "action_list": "changed | set_field: quantite_npk_cereale: this.value;",
      "parameter_list": "placeholder: Mettez 0 si aucun apport;",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.culture != 'coton'"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 17px;\">Veuillez entrer une quantité valide (nombre positif ou 0) !</span>",
      "condition": "@fields.attempt_submit_p13 && !@local.valid_npk_cerealeTRUE"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_fertilisant_info == 'oui'",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;"
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span><span style=\"font-size: 17px; color: #1e3656; font-weight: bold;\">Urée (sacs de 50kg)</span>"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/qte_uree_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sac.jpg",
      "style_list": "width: 50%; object-fit: contain;\n\n\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_uree",
      "value": "@fields.quantite_uree",
      "action_list": "changed | set_field: quantite_uree: this.value;",
      "parameter_list": "placeholder: Mettez 0 si aucun apport;",
      "condition": "@fields.on_fertilisant_info == 'oui'"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 17px;\">Veuillez entrer une quantité valide (nombre positif ou 0) !</span>",
      "condition": "@fields.attempt_submit_p13 && !@local.valid_uree"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.culture == 'riz'",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;\n"
    },
    {
      "type": "begin_display_group",
      "style_list": "\n"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;\"><span style=\"color: red;\">*</span> DAP (sacs de 50kg) :</label>"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/qte_dap_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/sac.jpg",
      "style_list": "width: 50%; object-fit: contain;\n\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_dap",
      "value": "@fields.quantite_dap",
      "action_list": "changed | set_field: quantite_dap: this.value;",
      "parameter_list": "placeholder: Mettez 0 si aucun apport;",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.culture == 'riz'"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 12px;\">Veuillez entrer une quantité valide (nombre positif ou 0) !</span>",
      "style_list": "@fields.attempt_submit_p13 && !@local.valid_dap"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_fertilisant_info == 'oui'",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;\n"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span><label style=\"color: #1e3656; font-size: 17px;font-weight: bold;\">Un autre type d'engrais a-t-il été apporté ?</label>"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/autre_engrais_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; align-items: center; grid_gap: 15px; margin-top: 8px;"
    },
    {
      "type": "radio_button_grid",
      "name": "autre_engrais_mineral",
      "value": "@fields.autre_engrais_mineral",
      "action_list": "changed | set_field: autre_engrais_mineral : this.value;",
      "parameter_list": "answer_list: @data.oui_non;\nvariant: flex; item_width: 100px; grid_gap: 10px; style: secondary;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 17px;\">La sélection est obligatoire !</span>",
      "condition": "@fields.attempt_submit_p13 && !@fields.autre_engrais_mineral"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.autre_engrais_mineral == 'oui'",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;\n\n"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656;font-size: 17px ;font-weight: bold;\"><span style=\"color: red;\">*</span> Nom de l'autre engrais :</label>"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/nom_autre_engrais_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "nom_autre_engrais",
      "value": "@fields.nom_autre_engrais",
      "action_list": "changed | set_field: nom_autre_engrais: this.value;",
      "parameter_list": "placeholder: Précisez le nom (ou \"ne sais pas\");",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.autre_engrais_mineral == 'oui'"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.autre_engrais_mineral == 'oui'",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;\n\n"
    },
    {
      "type": "html",
      "value": "<label style=\"color: #1e3656; font-weight: bold;font-size: 17px;margin-top: 12px; display: block;\"><span style=\"color: red;\">*</span> Quantité apportée (sacs de 50kg) :</label>"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/qte_autre_engrais_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_autre_engrais",
      "value": "@fields.quantite_autre_engrais",
      "action_list": "changed | set_field: quantite_autre_engrais: this.value;",
      "parameter_list": "placeholder: Quantité (sacs);",
      "condition": "@fields.on_fertilisant_info == 'oui' && @fields.autre_engrais_mineral == 'oui'"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-size: 12px;\">Veuillez entrer une quantité valide (nombre positif ou 0) !</span>\n",
      "condition": "@fields.attempt_submit_p13 && (!@fields.quantite_autre_engrais || !/^\\d+(\\.\\d+)?$/.test(@fields.quantite_autre_engrais))"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page13_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page13_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('on_fertilisant_info_parcelle_N' + @fields.num_parcelle) : @fields.on_fertilisant_info;\n        click | set_field: @calc('qte_npk_coton_parcelle_N' + @fields.num_parcelle) : @fields.quantite_npk_coton;\n        click | set_field: @calc('qte_npk_cereale_parcelle_N' + @fields.num_parcelle) : @fields.quantite_npk_cereale;\n        click | set_field: @calc('qte_uree_parcelle_N' + @fields.num_parcelle) : @fields.quantite_uree;\n        click | set_field: @calc('qte_dap_parcelle_N' + @fields.num_parcelle) : @fields.quantite_dap;\n        click | set_field: @calc('autre_engrais_mineral_parcelle_N' + @fields.num_parcelle) : @fields.autre_engrais_mineral;\n        click | set_field: @calc('nom_autre_engrais_parcelle_N' + @fields.num_parcelle) : @fields.nom_autre_engrais;\n        click | set_field: @calc('qte_autre_engrais_parcelle_N' + @fields.num_parcelle) : @fields.quantite_autre_engrais;\n        click | set_field: attempt_submit_p13: false;\n        click | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
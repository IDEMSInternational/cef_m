{
  "flow_type": "template",
  "flow_name": "depenses_page12",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "name": "page_title",
      "value": "@global.calcul_depenses"
    },
    {
      "name": "total_depenses_recurrentes",
      "value": "@calc(Number(@fields.frais_condiment_annuel) + Number(@fields.frais_sante_annuel) + Number(@fields.frais_education_annuel) + Number(@fields.montant_autre_frais || 0))"
    },
    {
      "name": "total_depenses_investissements",
      "value": "@calc(Number(@fields.invest_maison) + Number(@fields.invest_mariage) + Number(@fields.invest_equipment)+ Number(@fields.montant_autre_invest || 0))"
    },
    {
      "name": "depenes_total_upa",
      "value": "@calc(Number(@local.total_depenses_recurrentes) + Number(@local.total_depenses_investissements))"
    },
    {
      "name": "total_depenses_recurrentes_cfa\n",
      "value": "@calc((Number(@local.total_depenses_recurrentes * 5)).toLocaleString('fr-FR').replace(/\\u202f/g, ' '))"
    },
    {
      "name": "total_depenses_investissements_cfa\n",
      "value": "@calc((Number(@local.total_depenses_investissements * 5)).toLocaleString('fr-FR').replace(/\\u202f/g, ' '))"
    },
    {
      "name": "depenes_total_upa_cfa\n",
      "value": "@calc((Number(@local.depenes_total_upa * 5)).toLocaleString('fr-FR').replace(/\\u202f/g, ' '))"
    },
    {
      "type": "subtitle",
      "value": "@global.total_depenses_recurrentes",
      "style_list": "font-size:20px;"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "style_list": "background: #FFF3E0; border-radius: 15px; text-align: center; border: 2px solid #E65100;"
    },
    {
      "type": "text",
      "value": "@local.total_depenses_recurrentes drm",
      "style_list": "color: #E65100; margin: 10px 0;"
    },
    {
      "type": "text",
      "value": " @local.total_depenses_recurrentes_cfa FCFA",
      "style_list": "color: #2E7D32; font-weight: bold; font-size: 20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.total_depenses_investissements",
      "style_list": "font-size:20px;"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "style_list": "background: #FFF3E0; border-radius: 15px; text-align: center; border: 2px solid #E65100;"
    },
    {
      "type": "text",
      "value": "@local.total_depenses_investissements drm",
      "style_list": "color: #E65100; margin: 10px 0;"
    },
    {
      "type": "text",
      "value": "@local.total_depenses_investissements_cfa FCFA",
      "style_list": "color: #2E7D32; font-weight: bold; font-size: 20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "subtitle",
      "value": "@global.depenes_total_upa",
      "style_list": "font-size:20px;"
    },
    {
      "type": "image",
      "value": "images/cfa_tot.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "text",
      "value": "@global.hint_price",
      "style_list": "color: gray; font-size: 16px;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "style_list": "background: #FFF3E0; border-radius: 15px; text-align: center; border: 2px solid #E65100;"
    },
    {
      "type": "text",
      "value": "@local.depenes_total_upa drm",
      "style_list": "color: #E65100; margin: 10px 0;"
    },
    {
      "type": "text",
      "value": "@local.depenes_total_upa_cfa FCFA",
      "style_list": "color: #2E7D32; font-weight: bold; font-size: 20px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_12_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_12_btn_continue",
      "value": "@global.btn_continue",
      "action_list": "click | set_field: total_depenses_recurrentes : @local.total_depenses_recurrentes;\nclick | set_field: total_depenses_investissements : @local.total_depenses_investissements;\nclick | set_field: depenes_total_upa : @local.depenes_total_upa;\n\nclick | emit: completed",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    },
    {
      "action_list": "\n"
    }
  ]
}
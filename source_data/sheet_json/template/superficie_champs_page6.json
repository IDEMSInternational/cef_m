{
  "flow_type": "template",
  "flow_name": "superficie_champs_page6",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "GESTION DES RÉSIDUS DE CULTURE"
    },
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "name": "v_nom_cult_prev",
      "value": "@calc(@fields.culture_prev == '999' ? @fields.autre_culture_prev : @fields.culture_prev)"
    },
    {
      "name": "valid_tige",
      "value": "@calc(!!@fields.tige_laisse_champ && @fields.tige_laisse_champ !== \"\")"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_tige"
    },
    {
      "type": "begin_display_group",
      "name": "grp_header"
    },
    {
      "type": "html",
      "value": "<h3 style=\"color: #1e3656; margin: 0; font-size: 16px; text-transform: uppercase;\">Gestion des résidus de la culture précédente</h3>"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "name": "grp_question"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red;\">*</span> Indiquez si les tiges de <b>@local.v_nom_cult_prev</b> sont restées et retournées dans le sol de la parcelle N⁰@fields.num_parcelle"
    },
    {
      "type": "audio",
      "parameter_list": "variant: button_only; src: audio/Superficie/tige_laisse_champ_fr.mp3; play_icon_asset: images/icons/audio/Speaker_Icon.svg;",
      "style_list": "float: right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "radio_button_grid",
      "name": "tige_laisse_champ",
      "value": "@fields.tige_laisse_champ",
      "action_list": "changed | set_field: tige_laisse_champ: this.value;",
      "parameter_list": "answer_list: @data.yes_no; variant: flex; item_width: 100px; grid_gap: 15px; style: secondary;"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%; margin-top: 15px; padding: 8px; background: #fff5f5; border-radius: 6px;"
    },
    {
      "type": "html",
      "value": "<span style=\"color: red; font-weight: bold;\">Réponse obligatoire !</span>",
      "condition": "@fields.attempt_submit && !@local.valid_tige",
      "style_list": "width:100px; height:100px; "
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page5_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page5_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('tige_laisse_champ_parcelle_N' + @fields.numero_parcelle) : @fields.tige_laisse_champ;\n\nclick | set_field: attempt_submit: false;\n\nclick | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "superficie_champs_page13",
  "status": "released",
  "rows": [
    {
      "name": "cult_princip_display",
      "value": "@calc(@fields.cult_princip || '')"
    },
    {
      "name": "association_current ",
      "value": "@calc(String(@fields.association_oui_non || '').trim())"
    },
    {
      "name": "raw_cult_asso",
      "value": "@calc(String(@fields.cult_asso_selected || @fields.cult_asso || '').trim())"
    },
    {
      "name": "autre1_val",
      "value": "@calc(String(@fields.autre_cult_asso1 || '').trim())"
    },
    {
      "name": "autre2_val",
      "value": "@calc(String(@fields.autre_cult_asso2 || '').trim())"
    },
    {
      "name": "cult_asso_display",
      "value": "@calc(@local.raw_cult_asso === 'autre_culture1' ? @local.autre1_val : @local.raw_cult_asso === 'autre_culture2' ? @local.autre2_val : @local.raw_cult_asso)"
    },
    {
      "name": "valid_prod_cult1",
      "value": "@calc(/^\\d+(\\.\\d+)?$/.test(@fields.production_parcelle_culture1 || '') && Number(@fields.production_parcelle_culture1) >= 0)"
    },
    {
      "name": "valid_prod_cult2",
      "value": "@calc(@local.association_current !== 'oui' || (/^\\d+(\\.\\d+)?$/.test(@fields.production_parcelle_culture2 || '') && Number(@fields.production_parcelle_culture2) >= 0))\n"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(!!@fields.on_production_info && (@fields.on_production_info === 'non' || (@fields.on_production_info === 'oui' && @local.valid_prod_cult1 && @local.valid_prod_cult2)))"
    },
    {
      "type": "title",
      "value": "PRODUCTION DE LA PARCELLE"
    },
    {
      "type": "begin_display_group",
      "style_list": "margin-bottom: 15px;"
    },
    {
      "type": "text",
      "value": "@global.note_info_quant",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_13_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/on_info_recolte_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_radio_list",
      "name": "on_production_info",
      "value": "@fields.on_production_info",
      "action_list": "changed | set_field: on_production_info: this.value;"
    },
    {
      "type": "begin_data_items",
      "value": "@data.oui_non"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "end_radio_list"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_production_info== 'non'",
      "style_list": "margin: 15px 0; padding: 12px; background: #fff3cd;"
    },
    {
      "type": "text",
      "value": "@global.hint_prod_no",
      "style_list": "margin: 0; color: #856404; font-size: 13px; line-height: 1.4;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_production_info == 'oui'",
      "style_list": "display: block; width: 100%; margin-top: 15px; padding: 12px; "
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.hint_prod_name",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/pro_cult_prim_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/kg.jpg",
      "style_list": "width: 50%; object-fit: contain;"
    },
    {
      "type": "text_box",
      "value": "@fields.production_parcelle_culture1",
      "action_list": "changed | set_field: production_parcelle_culture1: this.value;",
      "parameter_list": "placeholder: Mettez 0 si aucune production;"
    },
    {
      "type": "text",
      "value": "@global.message_quant",
      "condition": "@fields.attempt_submit_p14 && !@local.valid_prod_cult1",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.on_production_info == 'oui' && @local.association_current == 'oui'",
      "style_list": "display: block; width: 100%; margin-top: 15px; padding: 12px; "
    },
    {
      "type": "begin_display_group"
    },
    {
      "type": "text",
      "value": "@global.hint_prod_asso",
      "style_list": "font-size: 20px; color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_13_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/pro_cult_asso_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "image",
      "value": "images/kg.jpg",
      "style_list": "width: 50%; object-fit: contain;"
    },
    {
      "type": "text_box",
      "name": "production_parcelle_culture2",
      "value": "@fields.production_parcelle_culture2",
      "action_list": "changed | set_field: production_parcelle_culture2: this.value;",
      "parameter_list": "placeholder: Mettez 0 si aucune production;"
    },
    {
      "type": "text",
      "value": "@global.message_quant",
      "condition": "@fields.attempt_submit_p14 && !@local.valid_prod_cult2",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page13_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page13_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('on_production_info_parcelle_N' + @fields.num_parcelle) : @fields.on_production_info;\n        click | set_field: @calc('production_culture1_parcelle_N' + @fields.num_parcelle) : @fields.production_parcelle_culture1;\n        click | set_field: @calc('production_culture2_parcelle_N' + @fields.num_parcelle) : @fields.production_parcelle_culture2;\n        click | set_field: attempt_submit_p14: false;\n        click | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
{
  "flow_type": "template",
  "flow_name": "besoins_animaux_page11",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "@global.recap_prevision_title"
    },
    {
      "type": "set_field",
      "name": "cal_superficie",
      "value": "@calc((Number(@fields.total_fane || 0) / 1700).toFixed(1))"
    },
    {
      "type": "set_field",
      "name": "cal_depense_total",
      "value": "@calc((Number(@fields.cal_depense_son || 0) + Number(@fields.cal_depense_tourteau || 0)).toFixed(1))"
    },
    {
      "type": "set_field",
      "name": "cal_depense_soins",
      "value": "@calc((Number(@fields.frais_veterinaire_cat_boeufs_labour || 0 ) + Number(@fields.frais_veterinaire_cat_embouche_bovine || 0 ) + Number(@fields.frais_veterinaire_cat_vache_laitiere || 0 ) + Number(@fields.frais_veterinaire_cat_autres_bovins || 0 ) + Number(@fields.frais_veterinaire_cat_asins || 0 ) + Number(@fields.frais_veterinaire_cat_embouche_ovine || 0 ) + Number(@fields.frais_veterinaire_cat_reste_ovins || 0 ) + Number(@fields.frais_veterinaire_cat_caprins || 0 )).toFixed(1))"
    },
    {
      "type": "text",
      "name": "note_cat_animales",
      "value": "Categories animales de l'UPA selectionnées: **@fields.cat_animaux_selected**"
    },
    {
      "type": "subtitle",
      "value": "@global.note_sup_fouragere"
    },
    {
      "type": "image",
      "value": "images/sup_fourrage.jpg",
      "style_list": "width:120px; height:120px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "style_list": "background:#f0f4f8 ; padding: 16px; border-radius: 12px; text-align: center; \n"
    },
    {
      "type": "text",
      "value": "@global.sup_fouragere"
    },
    {
      "type": "text",
      "value": "\n**@fields.cal_superficie ha**"

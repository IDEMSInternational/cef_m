    {
      "type": "end_display_group"
    },
    {
      "type": "text",
      "value": "@global.hint_sup_fouragere",
      "style_list": "@global.hint_style"
    },
    {
      "type": "subtitle",
      "value": "@global.note_mot_alim_betail"
    },
    {

{
  "flow_type": "template",
  "flow_name": "auth",
  "status": "released",
  "rows": [
    {
      "type": "title",
      "value": "Connexion CEF-M",
      "style_list": "text-align: center; font-size: 20px; font-weight: bold; color: #3e1f08; margin-bottom: 8px;"
    },
    {
      "type": "html",
      "value": "<div style=\"font-size: 13px; color: #555; text-align: center; margin-bottom: 20px;\">Veuillez entrer votre code UPA pour accéder à l'application</div>"
    },
    {
      "name": "valid_auth",
      "value": "@calc(Object.values(@data.upas || {}).some(item => String(item.code || '').trim().toLowerCase() === String(@fields.upa_code_input || '').trim().toLowerCase()))"
    },
    {
      "name": "auth_user_data",
      "value": "@calc(Object.values(@data.upas || {}).find(item => String(item.code || '').trim().toLowerCase() === String(@fields.upa_code_input || '').trim().toLowerCase()))"
    },
    {
      "type": "text",
      "value": "Code UPA"
    },
    {
      "type": "text_box",
      "name": "upa_code_input",
      "value": "@fields.upa_code_input",
      "action_list": "changed | set_field: upa_code_input: this.value;",
      "parameter_list": "placeholder: Entrez votre code UPA ;"
    },
    {
      "type": "html",
      "value": "<div style=\"background-color: #ffebee; border: 1px solid #ffcdd2; color: #c62828; padding: 10px 14px; border-radius: 8px; font-size: 13px; text-align: center; margin: 16px 8px 0 8px; font-weight: 500;\">⚠️ Code UPA incorrectt !</div>",
      "condition": "@fields.attempt_login && !@local.valid_auth"
    },
    {
      "type": "begin_display_group",
      "style_list": "sticky: bottom; padding: 16px 24px; margin-top: 20px; display: flex; justify-content: center;"
    },
    {
      "type": "button",
      "value": "Se connecter",
      "action_list": "click | set_field: attempt_login : true;\nclick | set_field: upa_code : @fields.upa_code_input;\nclick | set_field: logged_user : @local.auth_user_data;\nclick | go_to: evaluation_anl ;",
      "condition": "@local.valid_auth",
      "style_list": "width: 100%; font-weight: bold; padding: 14px;"
    },
    {
      "type": "button",
      "value": "Se connecter",
      "action_list": "click | set_field: attempt_login : true",
      "condition": "!@local.valid_auth",
      "style_list": "width: 100%;padding: 14px; opacity: 0.7;                                \n"
    },
    {
      "type": "end_display_group"
    }
  ]
}
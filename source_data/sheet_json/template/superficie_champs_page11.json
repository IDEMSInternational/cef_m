{
  "flow_type": "template",
  "flow_name": "superficie_champs_page11",
  "status": "released",
  "rows": [
    {
      "name": "valid_quantite_fumure_organique",
      "value": "@calc(/^\\d+$/.test(@fields.quantite_fumure_organique) && Number(@fields.quantite_fumure_organique) >= 0)"
    },
    {
      "name": "valid_type_fumure",
      "value": "@calc(!!@fields.tas_ordures || !!@fields.fumier_parcs || !!@fields.fumier_fosses || !!@fields.autre_fumier)"
    },
    {
      "name": "valid_autre_text",
      "value": "@calc(!@fields.autre_fumier || (!!@fields.autre_fumier_texte && @fields.autre_fumier_texte.trim() !== ''))"
    },
    {
      "name": "completed_enabled",
      "value": "@calc(!!@fields.quantite_fumure_organique && @local.valid_quantite_fumure_organique && (Number(@fields.quantite_fumure_organique) === 0 || (Number(@fields.quantite_fumure_organique) > 0 && @local.valid_type_fumure && @local.valid_autre_text)))"
    },
    {
      "name": "type_fumure_selected",
      "value": "@calc([@fields.tas_ordures ? 'tas_ordures' : null, @fields.fumier_parcs ? 'fumier_parcs' : null, @fields.fumier_fosses ? 'fumier_fosses' : null, @fields.autre_fumier ? @fields.autre_fumier_texte : null].filter(Boolean).join(','))"
    },
    {
      "type": "title ",
      "value": "**QUANTITE DE FERTILISANT DANS LA PARCELLE N⁰@fields.num_parcelle DE @fields.nom_champ**"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: block; width: 100%; margin-top: 10px; padding: 10px;"
    },
    {
      "type": "text",
      "value": "@global.note_qtite_fumure",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_12_1",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/qte_fo_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "text",
      "value": "@global.note_no_fumure",
      "style_list": "color: #718096; font-size: 12px; margin-top: 2px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_display_group",
      "style_list": "display: flex; align-items: center; grid_gap: 15px; margin-top: 10px;"
    },
    {
      "type": "image",
      "value": "images/charrette.jpg",
      "style_list": "width:100px; height:100px; object-fit:contain; flex-shrink:0;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "quantite_fumure_organique",
      "value": "@fields.quantite_fumure_organique",
      "action_list": "changed | set_field: quantite_fumure_organique : this.value;",
      "parameter_list": "number_input: true\nplaceholder: Entrez le nombre de charetée;",
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "valid_quantite_fumure_organique",
      "value": "@global.warning_message",
      "condition": "!@fields.quantite_fumure_organique",
      "exclude_from_translation": true,
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "text",
      "value": "@global.message_positifValue",
      "condition": "!@fields.attempt_submit_p12 && !!@fields.quantite_fumure_organique && !@local.valid_quantite_fumure_organique",
      "exclude_from_translation": true,
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.quantite_fumure_organique > 0",
      "style_list": "display: block; width: 100%; margin-top: 25px; border-top: 1px dashed #cbd5e0; padding-top: 15px;"
    },
    {
      "type": "text",
      "value": "@global.note_type_fumure",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_12_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/type_fo_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "begin_data_items",
      "value": "@data.type_fumure",
      "condition": "@fields.quantite_fumure_organique > 0"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.quantite_fumure_organique > 0"
    },
    {
      "type": "simple_checkbox",
      "name": "@item.name",
      "value": "@fields.@item.name",
      "action_list": "changed | set_field: @item.name: !@fields.@item.name;",
      "parameter_list": "align: left; label_text: @item.text;\n",
      "exclude_from_translation": true,
      "style_list": "margin-bottom: 10px;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "text",
      "value": "@global.select_fumure\n",
      "condition": "@fields.attempt_submit_p12 && Number(@fields.quantite_fumure_organique) > 0 && !@local.valid_type_fumure",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "condition": "@fields.autre_fumier == true && Number(@fields.quantite_fumure_organique) > 0"
    },
    {
      "type": "text",
      "value": "@global.name_fumure",
      "style_list": "color: #1e3656; font-weight: bold;"
    },
    {
      "type": "audio",
      "name": "audio_12_2",
      "parameter_list": "variant: button_only;\nsrc: audio/Superficie/autre_fo_fr.mp3;\nplay_icon_asset: images/icons/audio/Speaker_Icon.svg;\n",
      "style_list": "float : right;"
    },
    {
      "type": "end_display_group"
    },
    {
      "type": "text_box",
      "name": "autre_fumier_texte",
      "value": "@fields.autre_fumier_texte",
      "action_list": "changed | set_field: autre_fumier_texte: this.value;",
      "parameter_list": "max_length: 30;\nplaceholder: Ecrivez le nom ",
      "condition": "@fields.autre_fumier == true && Number(@fields.quantite_fumure_organique) > 0",
      "exclude_from_translation_1": true
    },
    {
      "type": "text",
      "name": "html_text",
      "value": "@global.warring_name_fumure\n",
      "condition": "@fields.attempt_submit_p12 && Number(@fields.quantite_fumure_organique) > 0 && @fields.autre_fumier == true && !@fields.autre_fumier_texte",
      "style_list": "color: red; font-size: 13px;"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "exclude_from_translation": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page12_button_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page12_button_continue",
      "value": "Continuer",
      "action_list": "click | set_field: @calc('quantite_fumure_organique_parcelle_N' + @fields.num_parcelle) : @fields.quantite_fumure_organique;\n        click | set_field: @calc('type_fumure_selected_parcelle_N' + @fields.num_parcelle) : @local.type_fumure_selected;\n        click | set_field: @calc('autre_fumier_texte_parcelle_N' + @fields.num_parcelle) : @fields.autre_fumier_texte;\n        click | set_field: attempt_submit_p12: false;\n        click | emit: completed;",
      "parameter_list": "disabled: !@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}
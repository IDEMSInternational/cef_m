{
  "flow_type": "template",
  "flow_name": "cultures_page17",
  "status": "released",
  "rows": [
    {
      "name": "attempt_submit",
      "value": "@fields.attempt_submit"
    },
    {
      "name": "besoins_zero_ou_non",
      "value": "@calc(Number(@fields.besoins_prevue_npk_coton_14_18_18 || 0) + Number(@fields.besoins_prevue_npk_cereale_15_15_15 || 0) + Number(@fields.besoins_prevue_npk_cereale_17_17_17 || 0) + Number(@fields.besoins_prevue_dap || 0) + Number(@fields.besoins_prevus_uree || 0))"
    },
    {
      "type": "title",
      "value": "@global.source_approvision_engrais"
    },
    {
      "type": "begin_data_items",
      "value": "@data.source_approvision",
      "parameter_list": "style: column; "
    },
    {
      "type": "simple_checkbox",
      "name": "@item.name",
      "value": "@fields.@item.name",
      "action_list": "changed | set_field: @item.name: !@fields.@item.name;",
      "parameter_list": "label_text: @item.text; reverse: false; align: left; ",
      "style_list": "margin-bottom: 10px;"
    },
    {
      "type": "end_data_items"
    },
    {
      "type": "begin_display_group",
      "parameter_list": "style: column",
      "condition": "@fields.autre_source"
    },
    {
      "type": "subtitle",
      "value": "@global.autre_source_approv_engrais"
    },
    {
      "type": "image",
      "value": "images/ecrire.jpg",
      "style_list": "width: 40%; object-fit: contain; "
    },
    {
      "type": "text",
      "value": "@global.autre_source_approv_engrais_hint",
      "style_list": "@global.hint_style"
    },
    {
      "type": "text_box",
      "name": "autre_source_approvision_engrais",
      "value": "@fields.autre_source_approvision_engrais",
      "action_list": "changed | set_field : autre_source_approvision_engrais: this.value;",
      "parameter_list": "number_input: true;\nplaceholder: @global.texte_placeholder;"
    },
    {
      "type": "text",
      "value": "@global.reponse_obligatoire",
      "condition": "@fields.attempt_submit && !@fields.autre_source_approvision_engrais",
      "style_list": "@global.reponse_style"
    },
    {
      "type": "end_display_group"
    },
    {
      "name": "liste_engrais_source",
      "value": "@calc([@fields.autoproduit ? 'autoproduit' : null,@fields.achat_cmdt_op_coton ? 'achat_cmdt_op_coton' : null,@fields.achat_subvention ? 'achat_subvention' : null,@fields.achat_individuel ? 'achat_individuel' : null,@fields.achat_collectif_op_cereale ? 'achat_collectif_op_cereale' : null,@fields.achat_credit_op_cereale ? 'achat_credit_op_cereale' : null,@fields.don ? 'don' : null,@fields.autre_source ? 'autre_source' : null].filter(v => v !== null).join(','))"
    },
    {
      "name": "valid_engrais_source",
      "value": "@calc(@fields.autoproduit || @fields.achat_cmdt_op_coton || @fields.achat_subvention || @fields.achat_individuel || @fields.achat_collectif_op_cereale || @fields.achat_credit_op_cereale || @fields.don || @fields.autre_source)",
      "action_list": "\n\n\n\n\n"
    },
    {
      "name": "engrais_source_loop_idx",
      "value": "@calc(Number(0))"
    },
    {
      "name": "engrais_source_label",
      "value": "@calc([@fields.autoproduit ? 'autoproduit' : null, @fields.achat_cmdt_op_coton ? 'achat_cmdt_op_coton' : null, @fields.achat_subvention ? 'achat_subvention' : null, @fields.achat_individuel ? 'achat_individuel' : null, @fields.achat_collectif_op_cereale ? 'achat_collectif_op_cereale' : null, @fields.achat_credit_op_cereale ? 'achat_credit_op_cereale' : null, @fields.don ? 'don' : null, @fields.autre_source ? 'autre_source' : null].filter(v => v !== null).at(Number(@local.engrais_source_loop_idx)) || '')"
    },
    {
      "name": "engrais_source_count",
      "value": "@calc([@fields.autoproduit, @fields.achat_cmdt_op_coton, @fields.achat_subvention, @fields.achat_individuel, @fields.achat_collectif_op_cereale, @fields.achat_credit_op_cereale, @fields.don, @fields.autre_source].filter(v => !!v).length)"
    },
    {
      "name": "completed_enabled",
      "value": "@local.valid_engrais_source "
    },
    {
      "type": "text",
      "name": "error_select",
      "value": "@global.select_error_message",
      "condition": "!@local.valid_engrais_source",
      "style_list": "color: #d71920; background: #fff5f5; padding: 12px; font-size: 13px; margin-top: 15px; text-align: center; font-weight: 600;"
    },
    {
      "type": "begin_display_group",
      "value": " ",
      "parameter_list": "sticky: bottom;",
      "style_list": "padding: 12px 24px;"
    },
    {
      "type": "round_button",
      "name": "page_17_btn_back",
      "action_list": "click | emit: uncompleted",
      "parameter_list": "icon_src: arrow-back;\nvariant: no-background;"
    },
    {
      "type": "button",
      "name": "page_17_btn_attempt_submit",
      "value": "Continuer",
      "action_list": "click | set_field: attempt_submit: true;",
      "condition": "!@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "button",
      "name": "page_17_btn_continue",
      "value": "Continuer",
      "action_list": "click | set_field: liste_engrais_source : @local.liste_engrais_source;\nclick | set_field: valid_engrais_source : @local.valid_engrais_source;\nclick | set_field: engrais_source_loop_idx : @local.engrais_source_loop_idx;\nclick | set_field: engrais_source_label : @local.engrais_source_label;\nclick | set_field: engrais_source_count : @local.engrais_source_count;\nclick | set_field: besoins_zero_ou_non : @local.besoins_zero_ou_non;\n\n\nclick | emit: completed",
      "parameter_list": "disabled: !@local.completed_enabled",
      "condition": "@local.completed_enabled",
      "style_list": "flex: 1"
    },
    {
      "type": "end_display_group"
    }
  ]
}